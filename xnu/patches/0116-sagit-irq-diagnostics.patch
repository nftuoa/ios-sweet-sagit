+
+#if defined(SWEET)
+/*
+ * Bring-up aid: dump everything that decides whether this CPU can receive an
+ * interrupt, plus the interrupt counters kept in sleh.c. Called from IOKit
+ * after the console is up, so the values show up in the boot log.
+ */
+void
+sweet_gic_dump(const char *where)
+{
+	uint64_t ctl = sweet_gicr_pe ?
+	    _gic_read32(sweet_gicr_pe + 0x0) : 0; /* GICR_CTLR */
+	kprintf("SWEET GIC[%s]: mpidr=%#llx irqs(timer/ipi/other)=%u/%u/%u\n",
+	    where, __builtin_arm_rsr64("MPIDR_EL1") & 0xffffffULL,
+	    sweet_irq_counts[0], sweet_irq_counts[1], sweet_irq_counts[2]);
+	kprintf("SWEET GIC[%s]: ICC sre=%#llx ctlr=%#llx pmr=%#llx grp1=%#llx\n",
+	    where, __builtin_arm_rsr64("ICC_SRE_EL1"),
+	    __builtin_arm_rsr64("ICC_CTLR_EL1"), __builtin_arm_rsr64("ICC_PMR_EL1"),
+	    __builtin_arm_rsr64("ICC_IGRPEN1_EL1"));
+	kprintf("SWEET GIC[%s]: GICD_CTLR=%#x GICR_pe=%p CTLR=%#x ISENABLER0=%#x IGROUPR0=%#x TYPER=%#llx\n",
+	    where, gicd_base ? gicd_read32(GICD_CTLR) : 0, (void *)sweet_gicr_pe,
+	    ctl,
+	    sweet_gicr_pe ? _gic_read32(sweet_gicr_pe + GICR_ISENABLER0) : 0,
+	    sweet_gicr_pe ? _gic_read32(sweet_gicr_pe + GICR_IGROUPR0) : 0,
+	    sweet_gicr_pe ? _gic_read64(sweet_gicr_pe + GICR_TYPER) : 0);
+	kprintf("SWEET GIC[%s]: cntfrq=%llu cntpct=%llu cntv_ctl=%#llx cntv_tval=%#llx\n",
+	    where, __builtin_arm_rsr64("CNTFRQ_EL0"),
+	    __builtin_arm_rsr64("CNTPCT_EL0"), __builtin_arm_rsr64("CNTV_CTL_EL1"),
+	    __builtin_arm_rsr64("CNTV_TVAL_EL0"));
+}
+#endif /* SWEET */
