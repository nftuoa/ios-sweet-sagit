diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -727,6 +727,23 @@
 	add	x11, x11, x15
 	subs	x14, x14, #1
 	b.ne	1b
+
+	/*
+	 * After the bootstrap TTBR0 teardown the early console and the Apple
+	 * framebuffer glue keep drawing through a kernel-VA alias:
+	 * arm_vm_init.c sweet_early_map_final() expects SWEET_EARLY_FB_VA
+	 * (= VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE = 0xffffffe000200000 with the
+	 * 4 KiB layout) to have a table entry in the KVA root and fills its L2
+	 * slots itself.  Its L1 index is 0x80, which the DRAM mapping (L1 entries
+	 * 1..3) does not touch, and one L1 entry covers 1 GiB - far more than the
+	 * 36 MiB splash region.
+	 */
+	MOV64	x10, 0xffffffe000200000
+	add	x13, x2, #(2 * PGBYTES)			// page after the FB identity table
+	orr	x14, x13, #(ARM_TTE_BOOT_TABLE)
+	and	x12, x10, #(ARM_TT_L1_INDEX_MASK)
+	lsr	x12, x12, #(ARM_TT_L1_SHIFT)
+	str	x14, [x3, x12, lsl #TTE_SHIFT]		// KVA root: alias L2 table
 #else
 	/*
 	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1848,10 +1848,20 @@
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
 	assert(*slot == ARM_TTE_EMPTY);
-	*slot = SWEET_EARLY_FB_PA | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
-	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
-	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
-	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	/*
+	 * A 16 KiB-granule L2 block covers 32 MiB, which holds the whole splash
+	 * region.  With the 4 KiB granule the block is only 2 MiB, so the 36 MiB
+	 * described by the ADT need 18 consecutive blocks in the same L2 table
+	 * (start.s reserved that table for exactly this).
+	 */
+	unsigned int nblocks = (unsigned int)(0x2400000ull / ARM_TT_L2_SIZE);
+	for (unsigned int i = 0; i < nblocks; i++) {
+		slot[i] = (SWEET_EARLY_FB_PA + i * ARM_TT_L2_SIZE) |
+		    ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
 #endif
