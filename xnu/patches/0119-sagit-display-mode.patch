+/*
+ * One chunk of a GetBlock() reply.  Only block 0x40 has an observable
+ * layout: IOMobileFramebufferGetDigitalOutMode() reads two int32 at +4
+ * (mode) and +8 (state) out of the 40 bytes it asked for.  The 0x48
+ * (2752 B), 0x4a (2056 B) and 0x4d (1580 B) blocks are vendor blobs;
+ * QuartzCore only records whether the 0x4d probe returned success and
+ * only checks the first word of 0x48/0x4a, so they stay zero.
+ */
+static void
+sweet_fb_get_block(AppleCLCD *fb, uint64_t block, uint64_t offset,
+    void *buffer, size_t size)
+{
+	uint8_t rec[SWEET_FB_BLOCK_DIGITAL_OUT_SIZE];
+
+	if (buffer == NULL || size == 0 || block != SWEET_FB_BLOCK_DIGITAL_OUT) {
+		return;         /* the caller has already zeroed the buffer */
+	}
+	bzero(rec, sizeof(rec));
+	uint32_t mode = 1;      /* digital output enabled */
+	uint32_t state = fb->fPowerOff ? 0 : 1;
+	memcpy(rec + 4, &mode, sizeof(mode));
+	memcpy(rec + 8, &state, sizeof(state));
+	for (size_t i = 0; i < size; i++) {
+		uint64_t src = offset + i;
+		((uint8_t *)buffer)[i] = src < sizeof(rec) ? rec[src] : 0;
+	}
+}
