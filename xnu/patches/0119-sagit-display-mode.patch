+/*
+ * QuartzCore's AppleDisplay constructor reads IOMFBDisplayRefresh as a
+ * CFDictionary through IOMobileFramebufferCopyProperty() and feeds
+ * "displayRefreshStepMachTime" to CA::WindowServer::AppleCLCDDisplay::
+ * heartbeat_rate() (0x1882dc324 in the iOS 16.7 QuartzCore image).  The
+ * value is a mach_absolute_time() delta in ticks: multiplying it by the
+ * timebase gives the frame period in seconds, i.e. 1/60.  Without this
+ * property heartbeat_rate() falls back to a 1/60 s constant, but the
+ * FBSDisplayMode refresh published to SpringBoard stays 0 Hz.
+ */
+static void
+sweet_fb_set_refresh_property(IOService *service, uint32_t hz)
+{
+	mach_timebase_info_data_t tb;
+	OSDictionary *dict;
+	OSNumber *step;
+	uint64_t ticks;
+
+	clock_timebase_info(&tb);
+	if (hz == 0) {
+		hz = SWEET_FB_REFRESH_HZ;
+	}
+	/* ticks = (1e9 / hz) ns converted to mach absolute time units */
+	ticks = 1000000000ULL / hz;
+	if (tb.numer != 0 && tb.denom != 0) {
+		ticks = ticks * (uint64_t)tb.denom / (uint64_t)tb.numer;
+	}
+	if (ticks > 0xffffffffULL) {
+		ticks = 0xffffffffULL;
+	}
+	dict = OSDictionary::withCapacity(1);
+	if (dict == NULL) {
+		return;
+	}
+	step = OSNumber::withNumber((unsigned long long)ticks, 32);
+	if (step != NULL) {
+		dict->setObject("displayRefreshStepMachTime", step);
+		step->release();
+	}
+	service->setProperty("IOMFBDisplayRefresh", dict);
+	dict->release();
+}
