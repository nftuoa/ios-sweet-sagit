+#define ZAP_PFX			"SWEET ZAP: "
+
+/*
+ * Raw SCM return codes, drivers/soc/qcom/scm.c:30-37.  These are what the
+ * monitor puts in x0; the vendor then folds several of them into -EINVAL /
+ * -ENOMEM / -EBUSY / -EOPNOTSUPP with scm_remap_error() (scm.c:175), so the
+ * number printed below is the monitor's code, not an errno.
+ */
+#define SCM_EINVAL_ADDR		3
+#define SCM_EINVAL_ARG		4
+#define SCM_EUNKNOWN		5
+#define SCM_ENOMEM		6
+#define SCM_EBUSY		7
+#define SCM_EUNSUPPORTED	8
+
+/* kgsl-3d0 register window and the one RBBM register the acceptance test
+ * needs (a5xx_reg.h dword 0xF400 << 2; the same number sweet_gpuprobe.c uses). */
+#define ZAP_KGSL_PA			0x05000000u
+#define ZAP_KGSL_SZ			0x40000u
+#define ZAP_RBBM_HW_VERSION		0x00000u
+#define ZAP_RBBM_SECVID_TRUST_CNTL	0x3d000u
+
+/* bsd/dev/sweet_zap_image.c, generated by mi6/sagit/tools/mkzap.py. */
+extern const unsigned char sweet_a540_zap_image[];
+extern const unsigned long sweet_a540_zap_image_size;
+extern const char sweet_a540_zap_image_sha256[];
+
+static struct {
+	unsigned	delay_s;
+	vm_offset_t	va;
+	vm_size_t	alloc;
+	vm_size_t	len;
+	uint64_t	pa;
+	bool		skip_mem_setup;
+	bool		started;
+} zap;
+
+static int zap_sleep_chan;
+
+static uint32_t
+zap_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+zap_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dsb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static uint32_t
+zap_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) |
+	    ((uint32_t)p[3] << 24);
+}
+
+/*
+ * Normalise the monitor's x0 to an SCM code.  The codes are small (0..8) and
+ * travel in a 32-bit register, but a monitor is free to sign-extend them into
+ * x0, so EINVAL_ADDR (3) can arrive either as 0x3 or as 0xfffffffffffffffd.
+ * Both mean the same thing and both are printed; only the classification uses
+ * this normalised value.
+ */
+static int
+sweet_scm_code(uint64_t r0)
+{
+	int32_t lo = (int32_t)(uint32_t)r0;
+
+	if (lo < 0 && lo >= -16) {
+		return -lo;
+	}
+
+	return lo;
+}
+
+/*
+ * The monitor's x0, named.  Only the codes the SCM library itself defines are
+ * named here; anything else is printed raw, because inventing a meaning for an
+ * unknown code is worse than showing the number.
+ */
+static const char *
+sweet_scm_r0_name(uint64_t r0)
+{
+	switch (sweet_scm_code(r0)) {
+	case 0:
+		return "success";
+	case SCM_RET_INTERRUPTED:
+		return "interrupted (retried)";
+	case SCM_EINVAL_ADDR:
+		return "EINVAL_ADDR: bad buffer address";
+	case SCM_EINVAL_ARG:
+		return "EINVAL_ARG: bad argument";
+	case SCM_EUNKNOWN:
+		return "EUNKNOWN";
+	case SCM_ENOMEM:
+		return "ENOMEM";
+	case SCM_EBUSY:
+		return "EBUSY";
+	case SCM_EUNSUPPORTED:
+		return "EUNSUPPORTED";
+	default:
+		return "unrecognised";
+	}
+}
+
+/*
+ * ret[0] of a PAS call.  0 is success.  The vendor driver never decodes a
+ * non-zero value -- pil_tz_auth_and_reset() only tests ret[0] != 0
+ * (subsys-pil-tz.c:682-726) and the TZ documents no code space to the AP side
+ * -- so neither do we: the number is printed and the report lists what to
+ * compare it against.
+ */
+static const char *
+sweet_pas_verdict_name(uint64_t v)
+{
+	return (v == 0) ? "0 (accepted)" : "non-zero (rejected)";
+}
+
+/*
+ * Which SMC convention does this monitor answer?  The same two-step test stage
+ * 1 performs, repeated here so the zap path does not depend on stage 1 having
+ * run in the same boot.
+ */
+static int
+sweet_scm_detect(uint64_t *mask_out, const char **tag_out)
+{
+	static const uint64_t masks[2] = { SMC64_MASK, 0 };
+	static const char * const tags[2] = { "smc64", "smc32" };
+	int i;
+
+	for (i = 0; i < 2; i++) {
+		int available = 0;
+		int ret;
+
+		ret = sweet_scm_is_available(masks[i], SCM_SVC_INFO,
+		    SCM_INFO_IS_CALL_AVAIL, &available, NULL);
+		if (ret == 0 && available != 0) {
+			*mask_out = masks[i];
+			*tag_out = tags[i];
+			return 0;
+		}
+	}
+
+	return -1;
+}
+
+/*
+ * Check the bytes the monitor is about to authenticate: \x7fELF, a program
+ * header table that fits, and segments that fit the image.  The image is
+ * a540_zap.elf, so a healthy boot prints the same three headers readelf does.
+ */
+static int
+sweet_zap_check_image(const uint8_t *img, vm_size_t len)
+{
+	uint32_t e_entry, e_phoff;
+	unsigned e_phnum, i;
+
+	if (len < 52 || img[0] != 0x7f || img[1] != 'E' || img[2] != 'L' ||
+	    img[3] != 'F') {
+		printf(ZAP_PFX "buffer does not start with \\x7fELF; refusing to "
+		    "hand it to the monitor\n");
+		return -1;
+	}
+
+	e_entry = zap_le32(img + 0x18);
+	e_phoff = zap_le32(img + 0x1c);
+	e_phnum = img[0x2c] | ((unsigned)img[0x2d] << 8);
+	printf(ZAP_PFX "ELF32 in the buffer: entry 0x%x, phoff 0x%x, phnum %u\n",
+	    e_entry, e_phoff, e_phnum);
+	if (e_phnum == 0 || e_phnum > 16 || (vm_size_t)e_phoff + e_phnum * 32 >
+	    len) {
+		printf(ZAP_PFX "program header table does not fit the image; "
+		    "refusing\n");
+		return -1;
+	}
+
+	for (i = 0; i < e_phnum; i++) {
+		const uint8_t *ph = img + e_phoff + i * 32;
+		uint32_t type = zap_le32(ph);
+		uint32_t off = zap_le32(ph + 4);
+		uint32_t filesz = zap_le32(ph + 16);
+
+		if (filesz != 0 && (vm_size_t)off + filesz > len) {
+			printf(ZAP_PFX "  phdr%u (off 0x%x, filesz 0x%x) runs "
+			    "past the image; refusing\n", i, off, filesz);
+			return -1;
+		}
+		printf(ZAP_PFX "  phdr%u type=0x%x off=0x%x filesz=0x%x\n",
+		    i, type, off, filesz);
+	}
+
+	return 0;
+}
+
+/*
+ * Allocate one physically contiguous run, copy the image in, clean it out of
+ * the D-cache, and check that what is in the buffer is the ELF the monitor will
+ * be asked to authenticate.
+ *
+ * Vendor equivalent: dma_alloc_attrs(..., DMA_ATTR_STRONGLY_ORDERED) plus
+ * kmap_flush_unused() before the copy (subsys-pil-tz.c:604-621).  Without a
+ * DMA map in this port the buffer is ordinary cacheable kernel memory, so the
+ * clean is done explicitly, by physical address, which is the address family
+ * the monitor will read.
+ */
+static int
+sweet_zap_buffer(void)
+{
+	ppnum_t pn, pn_this;
+	vm_size_t alloc;
+	unsigned npages, i;
+	kern_return_t kr;
+
+	zap.len = (vm_size_t)sweet_a540_zap_image_size;
+	alloc = (zap.len + (vm_size_t)PAGE_MASK) & ~(vm_size_t)PAGE_MASK;
+
+	printf(ZAP_PFX "image %llu bytes, sha256 %s\n",
+	    (unsigned long long)sweet_a540_zap_image_size,
+	    sweet_a540_zap_image_sha256);
+
+	/*
+	 * Ask for the buffer below 4 GiB first.  PAS's legacy descriptor carries
+	 * the image address as a u32 (struct pas_init_image_req,
+	 * subsys-pil-tz.c:626-636), and sagit has 6 GiB of RAM, so a buffer
+	 * placed above 4 GiB is one truncation away from an EINVAL_ADDR that has
+	 * nothing to do with the image.
+	 */
+	kr = kmem_alloc_contig(kernel_map, &zap.va, alloc, PAGE_MASK,
+	    (ppnum_t)((0x100000000ull >> PAGE_SHIFT) - 1), 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT);
+	if (kr != KERN_SUCCESS) {
+		printf(ZAP_PFX "no contiguous memory below 4 GiB (%d); asking "
+		    "for any address\n", kr);
+		kr = kmem_alloc_contig(kernel_map, &zap.va, alloc, PAGE_MASK, 0,
+		    0, KMA_DATA | KMA_ZERO | KMA_PERMANENT,
+		    VM_KERN_MEMORY_IOKIT);
+	}
+	if (kr != KERN_SUCCESS) {
+		printf(ZAP_PFX "no physically contiguous memory for the image "
+		    "(%d); PAS not called\n", kr);
+		return -1;
+	}
+	zap.alloc = alloc;
+
+	pn = pmap_find_phys(kernel_pmap, (addr64_t)zap.va);
+	if (pn == 0) {
+		printf(ZAP_PFX "pmap_find_phys(va 0x%llx) found no page\n",
+		    (unsigned long long)zap.va);
+		return -1;
+	}
+	zap.pa = ptoa_64(pn);
+
+	npages = (unsigned)(alloc >> PAGE_SHIFT);
+	for (i = 1; i < npages; i++) {
+		pn_this = pmap_find_phys(kernel_pmap,
+		    (addr64_t)(zap.va + ((vm_offset_t)i << PAGE_SHIFT)));
+		if (pn_this != (ppnum_t)(pn + i)) {
+			printf(ZAP_PFX "buffer is NOT contiguous: page %u of %u "
+			    "is phys 0x%llx, expected 0x%llx; PAS needs a single "
+			    "run, not calling it\n", i, npages,
+			    (unsigned long long)ptoa_64(pn_this),
+			    (unsigned long long)ptoa_64(pn + i));
+			return -1;
+		}
+	}
+
+	printf(ZAP_PFX "buffer: %llu bytes (%u x %u B pages, phys 0x%llx%s), "
+	    "va 0x%llx\n", (unsigned long long)alloc, npages,
+	    (unsigned)PAGE_SIZE, (unsigned long long)zap.pa,
+	    (zap.pa + alloc) <= 0x100000000ull ? ", below 4 GiB" : "",
+	    (unsigned long long)zap.va);
+
+	memcpy((void *)zap.va, sweet_a540_zap_image, (size_t)zap.len);
+
+	/*
+	 * Clean and invalidate the whole allocation to the point of coherency,
+	 * by physical address: the monitor reads DRAM with its own MMU and
+	 * knows nothing about our cacheable mapping.  The tail of the last page
+	 * is flushed too, because mem_setup() is told about the whole run.
+	 */
+	flush_dcache64((addr64_t)zap.pa, (unsigned)alloc, TRUE);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	/*
+	 * Parse the ELF back out of the buffer.  This is the same three-header
+	 * image readelf shows for a540_zap.elf (phdrs at 0x0/0x1000/0x3000,
+	 * entry 0x5000), so the boot log carries a fingerprint of the exact
+	 * bytes the monitor is about to authenticate.
+	 */
+	return sweet_zap_check_image((const uint8_t *)zap.va, zap.len);
+}
+
+/*
+ * One PAS call: issue it, print the register set, return the transport status.
+ * ret[0] is left in *out for the caller, which is where the PAS verdict lives.
+ */
+static int
+sweet_zap_issue(uint64_t mask, const char *tag, const char *name, uint32_t cmd,
+    uint64_t arginfo, uint64_t a0, uint64_t a1, uint64_t a2,
+    struct sweet_scm_ret *out)
+{
+	uint64_t fn = SCM_SIP_FNID(SCM_SVC_PIL, cmd) | mask;
+	int ret;
+
+	printf(ZAP_PFX "[%s] %s fn=0x%llx arginfo=0x%llx args={0x%llx, 0x%llx, "
+	    "0x%llx}\n", tag, name, (unsigned long long)fn,
+	    (unsigned long long)arginfo, (unsigned long long)a0,
+	    (unsigned long long)a1, (unsigned long long)a2);
+
+	ret = sweet_scm_smc(fn, arginfo, a0, a1, a2, 0, out);
+	printf(ZAP_PFX "[%s] %s -> r0=0x%llx (%s) r1=0x%llx (%s) r2=0x%llx "
+	    "r3=0x%llx\n", tag, name, (unsigned long long)out->r0,
+	    sweet_scm_r0_name(out->r0), (unsigned long long)out->r1,
+	    sweet_pas_verdict_name(out->r1), (unsigned long long)out->r2,
+	    (unsigned long long)out->r3);
+
+	return ret;
+}
+
+/*
+ * "This step failed" in one place, because the two failure families need
+ * different next steps: a transport error is about the call, a verdict is about
+ * the image or the pas_id.
+ */
+static void
+sweet_zap_fail(const char *what, int ret, const struct sweet_scm_ret *r)
+{
+	int code = sweet_scm_code(r->r0);
+
+	if (ret != 0) {
+		printf(ZAP_PFX "%s FAILED in the SCM transport: r0=0x%llx (%s)\n",
+		    what, (unsigned long long)r->r0, sweet_scm_r0_name(r->r0));
+		if (code == SCM_EINVAL_ADDR) {
+			printf(ZAP_PFX "  EINVAL_ADDR: the monitor could not "
+			    "read the physical buffer we handed it (phys "
+			    "0x%llx) -- see zap-load.md, failure signatures\n",
+			    (unsigned long long)zap.pa);
+		} else if (code == SCM_EBUSY) {
+			printf(ZAP_PFX "  EBUSY: the monitor is busy, usually "
+			    "a PAS session already open for id %u\n",
+			    SCM_PAS_ID_GPU_ZAP);
+		}
+	} else {
+		printf(ZAP_PFX "%s FAILED with PAS verdict r1=0x%llx: the "
+		    "monitor refused the image for pas_id %u (see zap-load.md)\n",
+		    what, (unsigned long long)r->r1, SCM_PAS_ID_GPU_ZAP);
+	}
+}
+
+/*
+ * The acceptance test, and the only GPU register this file touches: if the TZ
+ * really released the GPU, RBBM_SECVID_TRUST_CNTL becomes readable and writable
+ * and stays at 0.  RBBM_SECVID_TRUST_CONFIG (0x503c000) is deliberately *not*
+ * read first: that is the access that hung the bus on the first gpuprobe boot,
+ * and it buys nothing that TRUST_CNTL does not tell us.
+ *
+ * Returns 1 if the write stuck at 0, 0 if it was blocked, -1 if the test could
+ * not be run at all (the block is not powered -- the caller should run
+ * sweetgpuprobe=1, nosecvid, first).
+ */
+static int
+sweet_zap_secvid(void)
+{
+	vm_offset_t base;
+	uint32_t ver, before, rb, rb2, rb3;
+
+	base = ml_io_map(ZAP_KGSL_PA, ZAP_KGSL_SZ);
+	if (base == 0) {
+		printf(ZAP_PFX "SECVID test: ml_io_map(0x%x) failed; not "
+		    "tested\n", ZAP_KGSL_PA);
+		return -1;
+	}
+
+	ver = zap_rd(base, ZAP_RBBM_HW_VERSION);
+	if (ver == 0 || ver == 0xffffffffu) {
+		printf(ZAP_PFX "SECVID test: RBBM_HW_VERSION reads 0x%08x, the "
+		    "block is not powered/clocked; run sweetgpuprobe=1 "
+		    "(nosecvid) first, SECVID not tested\n", ver);
+		return -1;
+	}
+	printf(ZAP_PFX "SECVID test: RBBM_HW_VERSION 0x%08x = 0x%08x (block "
+	    "alive)\n", ZAP_KGSL_PA, ver);
+	printf(ZAP_PFX "SECVID test: a hang right here means the TZ still owns "
+	    "the window, i.e. auth_and_reset did not release it\n");
+
+	before = zap_rd(base, ZAP_RBBM_SECVID_TRUST_CNTL);
+	printf(ZAP_PFX "SECVID test: RBBM_SECVID_TRUST_CNTL 0x%08x = 0x%08x "
+	    "before\n", ZAP_KGSL_PA + ZAP_RBBM_SECVID_TRUST_CNTL, before);
+
+	zap_wr(base, ZAP_RBBM_SECVID_TRUST_CNTL, 0x00000000u);
+	rb = zap_rd(base, ZAP_RBBM_SECVID_TRUST_CNTL);
+	delay(1);
+	rb2 = zap_rd(base, ZAP_RBBM_SECVID_TRUST_CNTL);
+	delay(1);
+	rb3 = zap_rd(base, ZAP_RBBM_SECVID_TRUST_CNTL);
+	printf(ZAP_PFX "SECVID test: after writing 0 it reads 0x%08x 0x%08x "
+	    "0x%08x\n", rb, rb2, rb3);
+
+	return (rb == 0 && rb2 == 0 && rb3 == 0) ? 1 : 0;
+}
+
+static void
+sweet_zap_run(void)
+{
+	struct sweet_scm_ret r;
+	const char *tag = NULL;
+	uint64_t mask = 0;
+	int available, ret, i;
+	int accepted = 0;
+	int secvid = -1;
+
+	printf(ZAP_PFX "--- PAS zap load start ---\n");
+
+	if (sweet_scm_detect(&mask, &tag) != 0) {
+		printf(ZAP_PFX "no SMC64/SMC32 answer to IS_CALL_AVAIL; SCM is "
+		    "not usable from this kernel, PAS not attempted\n");
+		return;
+	}
+	printf(ZAP_PFX "using %s (fn_id | 0x%llx)\n", tag,
+	    (unsigned long long)mask);
+
+	/* Re-check the commands instead of trusting stage 1's log: this path has
+	 * to be safe to run in a boot where stage 1 was off. */
+	{
+		static const struct {
+			const char	*name;
+			uint32_t	 cmd;
+		} need[] = {
+			{ "init_image    ", SCM_PAS_INIT_IMAGE },
+			{ "mem_setup     ", SCM_PAS_MEM_SETUP },
+			{ "auth_and_reset", SCM_PAS_AUTH_AND_RESET },
+		};
+
+		for (i = 0; i < (int)(sizeof(need) / sizeof(need[0])); i++) {
+			ret = sweet_scm_is_available(mask, SCM_SVC_PIL,
+			    need[i].cmd, &available, NULL);
+			if (ret != 0 || available == 0) {
+				printf(ZAP_PFX "PAS %s (cmd 0x%x) is not "
+				    "available (r0=%d available=%d); the "
+				    "monitor does not offer this path, PAS not "
+				    "attempted\n", need[i].name, need[i].cmd,
+				    ret, available);
+				return;
+			}
+		}
+		printf(ZAP_PFX "init_image, mem_setup and auth_and_reset all "
+		    "available\n");
+	}
+
+	if (sweet_zap_buffer() != 0) {
+		printf(ZAP_PFX "--- PAS zap load abandoned before any PAS call "
+		    "---\n");
+		return;
+	}
+
+	/* 1. init_image: pas_id + the physical address of the image.  arginfo
+	 * 0x42 = SCM_ARGS(2, SCM_VAL, SCM_RW): the monitor may read the buffer;
+	 * the image is not written back by anything we rely on. */
+	ret = sweet_zap_issue(mask, tag, "init_image", SCM_PAS_INIT_IMAGE,
+	    SCM_ARGS2_VAL_RW, SCM_PAS_ID_GPU_ZAP, (uint64_t)zap.pa, 0, &r);
+	if (ret != 0 || r.r1 != 0) {
+		sweet_zap_fail("init_image", ret, &r);
+		goto release;
+	}
+	printf(ZAP_PFX "init_image accepted: the monitor read the image header "
+	    "at phys 0x%llx\n", (unsigned long long)zap.pa);
+
+	/* 2. mem_setup: the run the monitor may touch.  The vendor passes a
+	 * region here; with no region description for this subsystem in the
+	 * tree, the image run is what we can honestly describe. */
+	if (!zap.skip_mem_setup) {
+		ret = sweet_zap_issue(mask, tag, "mem_setup",
+		    SCM_PAS_MEM_SETUP, SCM_ARGS3, SCM_PAS_ID_GPU_ZAP,
+		    (uint64_t)zap.pa, (uint64_t)zap.alloc, &r);
+		if (ret != 0 || r.r1 != 0) {
+			sweet_zap_fail("mem_setup", ret, &r);
+			printf(ZAP_PFX "  if this is the only step that fails, "
+			    "retry with sweetzapskipmemsetup=1 to see whether "
+			    "auth_and_reset alone is accepted\n");
+			goto release;
+		}
+		printf(ZAP_PFX "mem_setup accepted: [0x%llx, 0x%llx) is the "
+		    "image run\n", (unsigned long long)zap.pa,
+		    (unsigned long long)(zap.pa + zap.alloc));
+	} else {
+		printf(ZAP_PFX "mem_setup skipped by sweetzapskipmemsetup=1\n");
+	}
+
+	/* 3. auth_and_reset: the call that should drop the GPU out of secure
+	 * mode.  Not atomic (SMC_ATOMIC_BIT clear), the vendor sleeps here too. */
+	ret = sweet_zap_issue(mask, tag, "auth_and_reset",
+	    SCM_PAS_AUTH_AND_RESET, SCM_ARGS1, SCM_PAS_ID_GPU_ZAP, 0, 0, &r);
+	if (ret != 0 || r.r1 != 0) {
+		sweet_zap_fail("auth_and_reset", ret, &r);
+		goto release;
+	}
+	accepted = 1;
+	printf(ZAP_PFX "auth_and_reset accepted: PAS id %u is authenticated "
+	    "and reset\n", SCM_PAS_ID_GPU_ZAP);
+
+	/* 4. The test that matters. */
+	secvid = sweet_zap_secvid();
+
+	/*
+	 * The buffer is deliberately not freed: the monitor may re-read the
+	 * image whenever it likes (auth_and_reset authenticates the bytes it was
+	 * pointed at), and 20 KiB once per boot is not worth a use-after-free
+	 * that only shows up as a TZ fault on the next call.
+	 */
+	if (secvid == 1) {
+		printf(ZAP_PFX "VERDICT (a): PAS accepted the zap image AND the "
+		    "SECVID write stuck at 0 -- the GPU is OUT of secure mode\n");
+	} else if (secvid == 0) {
+		printf(ZAP_PFX "VERDICT (b): PAS accepted the zap image but "
+		    "RBBM_SECVID_TRUST_CNTL did not stick at 0 -- the image is "
+		    "loaded, but the GPU was not released by this alone (on a5xx "
+		    "the zap shader still has to be run by kgsl)\n");
+	} else {
+		printf(ZAP_PFX "VERDICT (c): PAS accepted the zap image, SECVID "
+		    "untested (GPU not powered: run sweetgpuprobe=1 with "
+		    "sweetgpuprobenosecvid=1 and a shorter delay in the same "
+		    "boot)\n");
+	}
+	printf(ZAP_PFX "--- PAS zap load done (accepted=%d, secvid=%d) ---\n",
+	    accepted, secvid);
+	return;
+
+release:
+	/* The vendor calls shutdown() on the error path (pil_ops_trusted).  Try
+	 * it, print whatever comes back, and report the failure either way: a
+	 * failed shutdown is information, not a new problem. */
+	printf(ZAP_PFX "releasing PAS state (shutdown) after the failure\n");
+	ret = sweet_zap_issue(mask, tag, "shutdown", SCM_PAS_SHUTDOWN,
+	    SCM_ARGS1, SCM_PAS_ID_GPU_ZAP, 0, 0, &r);
+	if (ret != 0 || r.r1 != 0) {
+		printf(ZAP_PFX "shutdown also failed (r0=0x%llx, r1=0x%llx); "
+		    "the monitor holds no clean PAS session for id %u\n",
+		    (unsigned long long)r.r0, (unsigned long long)r.r1,
+		    SCM_PAS_ID_GPU_ZAP);
+	}
+	printf(ZAP_PFX "--- PAS zap load FAILED ---\n");
+}
+
+static void
+sweet_zap_sleep_s(unsigned s)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(s, NSEC_PER_SEC, &deadline);
+	(void)assert_wait_deadline(&zap_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+sweet_zap_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	sweet_zap_sleep_s(zap.delay_s);
+	sweet_zap_run();
+	printf(ZAP_PFX "thread exiting\n");
+	(void)thread_terminate(current_thread());
+}
+
+void
+sweet_zap_init(void)
+{
+	int enabled = 0;
+	int delay_s = 20;
+	int skip = 0;
+	thread_t thread;
+	kern_return_t kr;
+
+	if (zap.started) {
+		return;
+	}
+	zap.started = true;
+
+	(void)PE_parse_boot_argn("sweetzap", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("sweetzapdelay", &delay_s, sizeof(delay_s));
+	(void)PE_parse_boot_argn("sweetzapskipmemsetup", &skip, sizeof(skip));
+	zap.skip_mem_setup = (skip != 0);
+
+	if (!enabled) {
+		printf(ZAP_PFX "disabled (sweetzap=0)\n");
+		return;
+	}
+	if (delay_s < 1) {
+		delay_s = 1;
+	}
+	if (delay_s > 120) {
+		delay_s = 120;
+	}
+	zap.delay_s = (unsigned)delay_s;
+
+	/* Nothing above touched the monitor or the GPU: the whole experiment
+	 * happens in the thread, so a wrong window can only take down a boot
+	 * that asked for it. */
+	printf(ZAP_PFX "enabled: loading a540 zap through PAS in %u s "
+	    "(pas_id %u, mem_setup %s)\n", zap.delay_s, SCM_PAS_ID_GPU_ZAP,
+	    zap.skip_mem_setup ? "skipped" : "on");
+
+	kr = kernel_thread_start(sweet_zap_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf(ZAP_PFX "kernel_thread_start failed %d; PAS not run\n",
+		    kr);
+	}
+}
