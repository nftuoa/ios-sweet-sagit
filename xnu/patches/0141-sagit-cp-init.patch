+/* GPUCC offsets, msm-clocks-hwio-8998.h / clock-gpu-8998.c */
+#define CP_GPUCC_CXO_CBCR	0x1020u
+#define CP_GPUCC_CX_GDSCR	0x1004u
+#define CP_GPUCC_CX_GDS_HW	0x1008u
+#define CP_GPUCC_GX_DOMAIN	0x0130u
+#define CP_GPUCC_GFX3D_RCGR	0x1070u
+#define CP_GPUCC_GFX3D_CFG	0x1074u
+#define CP_GPUCC_GFX3D_CBCR	0x1098u
+#define CP_GPUCC_GX_BCR		0x1090u
+#define CP_GPUCC_GX_GDSCR	0x1094u
+
+/* GDSCR / domain / RCG / CBCR bits, gdsc-regulator.c + clock-local2.c */
+#define CP_GDSCR_PWR_ON		(1u << 31)
+#define CP_GDSCR_HW_CTRL	(1u << 1)
+#define CP_GDSCR_SW_OVERRIDE	(1u << 2)
+#define CP_GDSCR_SW_COLLAPSE	(1u << 0)
+#define CP_DOMAIN_CLAMP_IO	(1u << 0)
+#define CP_DOMAIN_GMEM_RESET	(1u << 4)
+#define CP_GX_BLK_ARES		(1u << 0)
+#define CP_RCG_UPDATE		(1u << 0)
+#define CP_RCG_ROOT_EN		(1u << 1)
+#define CP_RCG_ROOT_OFF		(1u << 31)
+#define CP_RCG_DIV_MASK		0x1fu
+#define CP_RCG_SRC_MASK		0x700u
+#define CP_RCG_SRC_CXO		0u
+#define CP_RCG_DIV_1		1u
+#define CP_CBCR_ENABLE		(1u << 0)
+#define CP_CBCR_HALT_MASK	0xf0000000u
+#define CP_CBCR_HALT_ON		0x00000000u
+#define CP_CBCR_HALT_NOC	0x20000000u
+
+/* GCC GPU clocks */
+#define CP_GCC_GPU_CFG_AHB_CBCR	0x71004u
+#define CP_GCC_GPU_BIMC_GFX	0x71010u
