+#define CP_GPUCC_SZ	0x00009000u
+#define CP_KGSL_PA	0x05000000u	/* qcom,kgsl-3d0@5000000, 0x40000 */
+#define CP_KGSL_SZ	0x00040000u
+#define CP_SMMU_PA	0x05040000u	/* arm,smmu-kgsl@5040000, 0x10000 */
+#define CP_SMMU_SZ	0x00010000u
+#define CP_GCC_PA	0x00100000u	/* qcom,gcc@100000, 0xb0000     */
+#define CP_GCC_SZ	0x000b0000u
