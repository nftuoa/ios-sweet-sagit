+/* kgsl / CP registers, byte offsets (dword << 2)                      */
+/* ------------------------------------------------------------------ */
+#define CP_RBBM_HW_VERSION	0x00000u	/* 0x000 << 2 */
+#define CP_RBBM_STATUS		0x013d4u	/* 0x4f5 << 2 */
+#define CP_RBBM_AHB_ERROR	0x013b4u	/* 0x4ed << 2 */
+#define CP_RBBM_AHB_ERR_STATUS	0x013d0u	/* 0x4f4 << 2 */
+#define CP_RBBM_ME_SPLIT	0x013c0u	/* 0x4f0 << 2 */
+#define CP_RBBM_PFP_SPLIT	0x013c4u	/* 0x4f1 << 2 */
+#define CP_RBBM_AHB_CNTL0	0x0024cu	/* 0x093 << 2 */
+#define CP_RBBM_AHB_CNTL1	0x00250u	/* 0x094 << 2 */
+
+#define CP_RB_BASE		0x02000u	/* 0x800 << 2 */
+#define CP_RB_BASE_HI		0x02004u	/* 0x801 << 2 */
+#define CP_RB_CNTL		0x02008u	/* 0x802 << 2 */
+#define CP_RB_RPTR		0x02018u	/* 0x806 << 2 */
+#define CP_RB_WPTR		0x0201cu	/* 0x807 << 2 */
+#define CP_ROQ_THRESHOLDS_1	0x0207cu	/* 0x81f << 2 */
+#define CP_ROQ_THRESHOLDS_2	0x02080u	/* 0x820 << 2 */
+#define CP_MEQ_THRESHOLDS	0x02094u	/* 0x825 << 2 */
+#define CP_MERCIU_SIZE		0x02098u	/* 0x826 << 2 */
+#define CP_ME_CNTL		0x020c8u	/* 0x832 << 2 */
+#define CP_PFP_INSTR_BASE_LO	0x020d4u	/* 0x835 << 2 */
+#define CP_PFP_INSTR_BASE_HI	0x020d8u	/* 0x836 << 2 */
+#define CP_PM4_INSTR_BASE_LO	0x020e0u	/* 0x838 << 2 */
+#define CP_PM4_INSTR_BASE_HI	0x020e4u	/* 0x839 << 2 */
+#define CP_ADDR_MODE_CNTL	0x02180u	/* 0x860 << 2 */
+#define CP_ME_STAT_DATA		0x02c50u	/* 0xb14 << 2 */
+#define CP_WFI_PEND_CTR		0x02c54u	/* 0xb15 << 2 */
+#define CP_INTERRUPT_STATUS	0x02c60u	/* 0xb18 << 2 */
+#define CP_HW_FAULT		0x02c68u	/* 0xb1a << 2 */
+#define CP_AHB_FAULT		0x02c6cu	/* 0xb1b << 2 */
+#define CP_PROTECT_STATUS	0x02c70u	/* 0xb1c << 2 */
+#define CP_IB1_BASE		0x02c7cu	/* 0xb1f << 2 */
+#define CP_IB1_BASE_HI		0x02c80u	/* 0xb20 << 2 */
+#define CP_IB1_BUFSZ		0x02c84u	/* 0xb21 << 2 */
+
+/* RBBM_STATUS bits (a5xx.xml.h:1979-1986) */
+#define CP_STATUS_CP_BUSY	(1u << 6)
+#define CP_STATUS_GPU_BUSY_CP	(1u << 30)
+
+/* CP_INTERRUPT_STATUS bits (a5xx.xml.h:902-913) */
+#define CP_INT_OPCODE		(1u << 0)
+#define CP_INT_RESERVED		(1u << 1)
+#define CP_INT_HW_FAULT		(1u << 2)
+#define CP_INT_DMA		(1u << 3)
+#define CP_INT_PROTECT		(1u << 4)
+#define CP_INT_AHB		(1u << 5)
+
+/* CP_RB_CNTL: BUFSZ = log2(ring bytes / 8), BLKSZ = log2(block bytes / 8),
+ * NO_UPDATE = disable the host RPTR shadow (mainline MSM_GPU_RB_CNTL_DEFAULT
+ * | AXXX_CP_RB_CNTL_NO_UPDATE; kgsl's A5XX_CP_RB_CNTL_DEFAULT has the same
+ * two size fields and programs CP_RB_RPTR_ADDR instead).  A 4 KiB ring is
+ * 1024 dwords, so BUFSZ = 9; 32-byte blocks, so BLKSZ = 2. */
+#define CP_RB_CNTL_BUFSZ(n)	(((n) & 0x3fu) << 0)
+#define CP_RB_CNTL_BLKSZ(n)	(((n) & 0x1fu) << 8)
+#define CP_RB_CNTL_NO_UPDATE	(1u << 15)
+
+/* SMMU (read-only diagnostics; this stage programs nothing) */
+#define CP_SMMU_sCR0		0x000u
+#define CP_SMMU_sGFSR		0x048u
+#define CP_SMMU_S2CR(n)		(0x200u + 4u * (n))
+
+/* ------------------------------------------------------------------ */
+/* Low physical region: /chosen/sweet-zap-region, the same 2 MiB hole  */
+/* the zap stage uses.  The zap path maps only +0 (metadata, 16 KiB)   */
+/* and +0x100000 (segments, 16 KiB), so +0x40000..+0x80000 is free.    */
+/* ------------------------------------------------------------------ */
+#define CP_REGION_PA_DEFAULT	0x98000000ull
+#define CP_REGION_SZ_DEFAULT	0x200000ull
+#define CP_REGION_PA_MIN	0x80000000ull
+#define CP_BELOW_4G		0x100000000ull
+
+#define CP_LOW_WIN_OFF		0x40000ull
+#define CP_LOW_WIN_SIZE		0x40000u
+#define CP_PFP_OFF		0x00000u	/* 64 KiB slot */
+#define CP_PM4_OFF		0x10000u	/* 64 KiB slot */
+#define CP_RING_OFF		0x20000u	/* 16 KiB of room, 4 KiB used */
+#define CP_IB_OFF		0x24000u
+#define CP_SCRATCH_OFF		0x25000u
+#define CP_SLOT_SIZE		0x10000u
+#define CP_RING_BYTES		0x1000u
+#define CP_RING_DWORDS		(CP_RING_BYTES / 4u)
+#define CP_IB_BYTES		0x1000u
+
+/* PM4 packets, adreno_pm4types.h */
+#define CP_ME_INIT		0x48u
+#define CP_INDIRECT_BUFFER_PFE	0x3fu
+#define CP_MEM_WRITE		0x3du
+
+/* The value the CP is asked to write; "CPOK" in ASCII. */
+#define CP_MAGIC		0x4b4f5043u
+
+/* Poll budgets.  The ME_INIT spin in kgsl is 2000 ms; the GPU may be running
+ * from the 19.2 MHz CXO here (gpu_pll0 is off on this port), so allow 3 s. */
+#define CP_ME_INIT_TIMEOUT_MS	3000u
+#define CP_IB_TIMEOUT_MS	3000u
+#define CP_PWR_TIMEOUT_US	500u
+
+/* bsd/dev/sweet_cp_image.c, generated by mi6/sagit/tools/mkcpfw.py. */
+struct sweet_cp_fw {
+	const char		*name;
+	const unsigned char	*data;
