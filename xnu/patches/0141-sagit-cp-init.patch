+extern const struct sweet_cp_fw sweet_a530_cp_fw[];
+extern const unsigned long sweet_a530_cp_fw_count;
+
+static struct {
+	vm_offset_t	gpucc;
+	vm_offset_t	kgsl;
+	vm_offset_t	smmu;
+	vm_offset_t	gcc;
+	vm_offset_t	low;		/* window at region + CP_LOW_WIN_OFF */
+	uint64_t	region_pa;
+	vm_size_t	region_size;
+	const char	*region_src;
+	uint64_t	win_pa;
+	uint64_t	pfp_pa;
+	uint64_t	pm4_pa;
+	uint64_t	ring_pa;
+	uint64_t	ib_pa;
+	uint64_t	scratch_pa;
+	unsigned	delay_s;
+	uint32_t	rptr0;
+	uint32_t	ahb_err0;
+	uint32_t	cp_int0;
+	uint32_t	cp_fault0;
+	uint32_t	cp_ahb0;
+	uint32_t	gfsr0;
+} scp;
+
+static int scp_started;
+static int scp_sleep_chan;
+
+/* ------------------------------------------------------------------ */
+/* MMIO helpers                                                        */
+/* ------------------------------------------------------------------ */
+static uint32_t
+scp_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+scp_wr_raw(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dsb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+/* Write, then read back: returns the read-back value. */
+static uint32_t
+scp_wr(const char *what, uint32_t off, uint32_t val)
+{
+	uint32_t was = scp_rd(scp.kgsl, off);
+	uint32_t rb;
+
+	scp_wr_raw(scp.kgsl, off, val);
+	rb = scp_rd(scp.kgsl, off);
+	printf(CP_PFX "W %-20s [0x%05x] = 0x%08x (was 0x%08x) rb 0x%08x%s\n",
+	    what, off, val, was, rb, rb == val ? "" : "  <-- DID NOT STICK");
+	return rb;
+}
+
+/* Poll `mask' in a register for `want', `us' microseconds. */
+static int
+scp_poll(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want,
+    unsigned us, const char *what)
+{
+	uint32_t v = scp_rd(base, off);
+
+	for (unsigned i = 0; i < us; ++i) {
+		if ((v & mask) == want) {
+			printf(CP_PFX "poll %s: 0x%08x after %u us\n", what, v, i);
+			return 0;
+		}
+		delay(1);
+		v = scp_rd(base, off);
+	}
+	printf(CP_PFX "poll %s: TIMEOUT after %u us, 0x%08x (mask 0x%08x want "
+	    "0x%08x)\n", what, us, v, mask, want);
+	return -1;
+}
+
+/* Poll a 32-bit register for an exact value, `ms' milliseconds. */
+static int
+scp_poll_eq(uint32_t off, uint32_t want, unsigned ms, const char *what)
+{
+	uint32_t v = 0;
+
+	for (unsigned i = 0; i < ms; ++i) {
+		v = scp_rd(scp.kgsl, off);
+		if (v == want) {
+			printf(CP_PFX "poll %s: 0x%08x after %u ms\n", what, v, i);
+			return 0;
+		}
+		delay(1000);
+	}
+	printf(CP_PFX "poll %s: TIMEOUT after %u ms, 0x%08x (wanted 0x%08x)\n",
+	    what, ms, v, want);
+	return -1;
+}
+
+static uint32_t
+scp_parity(uint32_t v)
+{
+	return (0x9669u >> ((v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^
+	    (v >> 16) ^ (v >> 20) ^ (v >> 24) ^ (v >> 28)) & 0xfu)) & 1u;
+}
+
+/* Type-7 packet header, adreno_pm4types.h cp_type7_packet(). */
+static uint32_t
+scp_pkt7(uint32_t opcode, uint32_t cnt)
+{
+	return (7u << 28) | (cnt & 0x3fffu) | (scp_parity(cnt) << 15) |
+	    ((opcode & 0x7fu) << 16) | (scp_parity(opcode & 0x7fu) << 23);
+}
+
+/* ------------------------------------------------------------------ */
+/* Power: the same sequence sweet_gpuprobe.c runs, kept separate so    */
+/* that the proven probe path is untouched.  Idempotent: every step is */
+/* skipped when the hardware already reports the target state.         */
+/* ------------------------------------------------------------------ */
+static bool
+scp_branch_running(uint32_t cbcr)
+{
+	uint32_t halt = cbcr & CP_CBCR_HALT_MASK;
+
+	return halt == CP_CBCR_HALT_ON || halt == CP_CBCR_HALT_NOC;
+}
+
+static int
+scp_branch_on(vm_offset_t base, uint32_t off, const char *what)
+{
+	uint32_t v = scp_rd(base, off);
+
+	if (scp_branch_running(v)) {
+		printf(CP_PFX "%s already on (0x%08x)\n", what, v);
+		return 0;
+	}
+	scp_wr_raw(base, off, v | CP_CBCR_ENABLE);
+	if (scp_poll(base, off, CP_CBCR_HALT_MASK, CP_CBCR_HALT_ON,
+	    CP_PWR_TIMEOUT_US, what) == 0) {
+		return 0;
+	}
+	if (scp_poll(base, off, CP_CBCR_HALT_MASK, CP_CBCR_HALT_NOC,
+	    CP_PWR_TIMEOUT_US, what) == 0) {
+		return 0;
+	}
+	printf(CP_PFX "%s did not start (0x%08x); the GPU window is not "
+	    "clocked\n", what, scp_rd(base, off));
+	return -1;
+}
+
+static int
+scp_gdsc_cx(void)
+{
+	uint32_t v = scp_rd(scp.gpucc, CP_GPUCC_CX_GDSCR);
+
+	scp_wr_raw(scp.gpucc, CP_GPUCC_CX_GDSCR,
+	    (v & ~(CP_GDSCR_HW_CTRL | CP_GDSCR_SW_OVERRIDE |
+	    CP_GDSCR_SW_COLLAPSE)));
+	__asm__ volatile("dsb osh" ::: "memory");
+	delay(1);
+	if (scp_poll(scp.gpucc, CP_GPUCC_CX_GDS_HW, CP_GDSCR_PWR_ON,
+	    CP_GDSCR_PWR_ON, CP_PWR_TIMEOUT_US, "gdsc_gpu_cx PWR_ON") != 0) {
+		printf(CP_PFX "gdsc_gpu_cx did not power on (GDSCR 0x%08x "
+		    "hw_ctrl 0x%08x)\n", scp_rd(scp.gpucc, CP_GPUCC_CX_GDSCR),
+		    scp_rd(scp.gpucc, CP_GPUCC_CX_GDS_HW));
+		return -1;
+	}
+	return 0;
+}
+
+static int
+scp_root_clock(void)
+{
+	uint32_t cmd = scp_rd(scp.gpucc, CP_GPUCC_GFX3D_RCGR);
+	uint32_t cfg;
+
+	if (!(cmd & CP_RCG_ROOT_OFF)) {
+		printf(CP_PFX "gfx3d root clock already on (0x%08x)\n", cmd);
+		return 0;
+	}
+	scp_wr_raw(scp.gpucc, CP_GPUCC_GFX3D_RCGR, cmd | CP_RCG_ROOT_EN);
+	if (scp_poll(scp.gpucc, CP_GPUCC_GFX3D_RCGR, CP_RCG_ROOT_OFF, 0,
+	    CP_PWR_TIMEOUT_US, "gfx3d ROOT_OFF") == 0) {
+		goto on;
+	}
+
+	/* Fallback: select CXO / 1 and trigger the update, exactly like
+	 * sweet_gpuprobe.c.  On the phone the normal path works. */
+	cfg = scp_rd(scp.gpucc, CP_GPUCC_GFX3D_CFG);
+	scp_wr_raw(scp.gpucc, CP_GPUCC_GFX3D_CFG,
+	    (cfg & ~(CP_RCG_SRC_MASK | CP_RCG_DIV_MASK)) |
+	    (CP_RCG_SRC_CXO << 8) | CP_RCG_DIV_1);
+	cmd = scp_rd(scp.gpucc, CP_GPUCC_GFX3D_RCGR);
+	scp_wr_raw(scp.gpucc, CP_GPUCC_GFX3D_RCGR, cmd | CP_RCG_UPDATE);
+	if (scp_poll(scp.gpucc, CP_GPUCC_GFX3D_RCGR, CP_RCG_UPDATE, 0,
+	    CP_PWR_TIMEOUT_US, "gfx3d UPDATE") != 0) {
+		printf(CP_PFX "gfx3d RCG update never completed; GX cannot be "
+		    "clocked\n");
+		return -1;
+	}
+	cmd = scp_rd(scp.gpucc, CP_GPUCC_GFX3D_RCGR);
+	scp_wr_raw(scp.gpucc, CP_GPUCC_GFX3D_RCGR, cmd | CP_RCG_ROOT_EN);
+	if (scp_poll(scp.gpucc, CP_GPUCC_GFX3D_RCGR, CP_RCG_ROOT_OFF, 0,
+	    CP_PWR_TIMEOUT_US, "gfx3d ROOT_OFF (CXO)") != 0) {
+		printf(CP_PFX "gfx3d root clock still off with CXO selected\n");
+		return -1;
+	}
+on:
+	printf(CP_PFX "gfx3d root clock on (CMD_RCGR 0x%08x CFG_RCGR 0x%08x)\n",
+	    scp_rd(scp.gpucc, CP_GPUCC_GFX3D_RCGR),
+	    scp_rd(scp.gpucc, CP_GPUCC_GFX3D_CFG));
+	return 0;
+}
+
+static int
+scp_gdsc_gx(void)
+{
+	uint32_t v = scp_rd(scp.gpucc, CP_GPUCC_GX_GDSCR);
+	uint32_t dom;
+
+	scp_wr_raw(scp.gpucc, CP_GPUCC_GX_GDSCR,
+	    v & ~(CP_GDSCR_HW_CTRL | CP_GDSCR_SW_OVERRIDE));
+
+	/* sw_reset pulse, domain GMEM_RESET pulse, drop CLAMP_IO. */
+	v = scp_rd(scp.gpucc, CP_GPUCC_GX_BCR);
+	scp_wr_raw(scp.gpucc, CP_GPUCC_GX_BCR, v | CP_GX_BLK_ARES);
+	__asm__ volatile("dsb osh" ::: "memory");
+	delay(1);
+	scp_wr_raw(scp.gpucc, CP_GPUCC_GX_BCR, v & ~CP_GX_BLK_ARES);
+	__asm__ volatile("dsb osh" ::: "memory");
+
+	dom = scp_rd(scp.gpucc, CP_GPUCC_GX_DOMAIN);
+	scp_wr_raw(scp.gpucc, CP_GPUCC_GX_DOMAIN, dom | CP_DOMAIN_GMEM_RESET);
+	__asm__ volatile("dsb osh" ::: "memory");
+	delay(1);
+	scp_wr_raw(scp.gpucc, CP_GPUCC_GX_DOMAIN, dom & ~CP_DOMAIN_GMEM_RESET);
+	__asm__ volatile("dsb osh" ::: "memory");
+	dom = scp_rd(scp.gpucc, CP_GPUCC_GX_DOMAIN);
+	scp_wr_raw(scp.gpucc, CP_GPUCC_GX_DOMAIN, dom & ~CP_DOMAIN_CLAMP_IO);
+	__asm__ volatile("dsb osh" ::: "memory");
+
+	v = scp_rd(scp.gpucc, CP_GPUCC_GX_GDSCR);
+	scp_wr_raw(scp.gpucc, CP_GPUCC_GX_GDSCR, v & ~CP_GDSCR_SW_COLLAPSE);
+	__asm__ volatile("dsb osh" ::: "memory");
+	delay(1);
+	if (scp_poll(scp.gpucc, CP_GPUCC_GX_GDSCR, CP_GDSCR_PWR_ON,
+	    CP_GDSCR_PWR_ON, CP_PWR_TIMEOUT_US, "gdsc_gpu_gx PWR_ON") != 0) {
+		printf(CP_PFX "gdsc_gpu_gx did not power on (GDSCR 0x%08x "
+		    "domain 0x%08x)\n", scp_rd(scp.gpucc, CP_GPUCC_GX_GDSCR),
+		    scp_rd(scp.gpucc, CP_GPUCC_GX_DOMAIN));
+		return -1;
+	}
+	return 0;
+}
+
+static int
+scp_power_up(void)
+{
+	uint32_t ver;
+
+	scp.gpucc = ml_io_map(CP_GPUCC_PA, CP_GPUCC_SZ);
+	scp.kgsl = ml_io_map(CP_KGSL_PA, CP_KGSL_SZ);
+	scp.smmu = ml_io_map(CP_SMMU_PA, CP_SMMU_SZ);
+	scp.gcc = ml_io_map(CP_GCC_PA, CP_GCC_SZ);
+	if (!scp.gpucc || !scp.kgsl || !scp.smmu || !scp.gcc) {
+		printf(CP_PFX "ml_io_map failed (gpucc=%#lx kgsl=%#lx smmu=%#lx "
+		    "gcc=%#lx); nothing touched\n", (unsigned long)scp.gpucc,
+		    (unsigned long)scp.kgsl, (unsigned long)scp.smmu,
+		    (unsigned long)scp.gcc);
+		return -1;
+	}
+
+	/* gpucc_cxo_clk is the root of every GPUCC RCG and GDSC. */
+	if (scp_branch_on(scp.gpucc, CP_GPUCC_CXO_CBCR,
+	    "gpucc_cxo_clk") != 0) {
+		return -1;
+	}
+	/* The GPU register window (RBBM, CP, SMMU) is behind this one. */
+	if (scp_branch_on(scp.gcc, CP_GCC_GPU_CFG_AHB_CBCR,
+	    "gcc_gpu_cfg_ahb_clk") != 0) {
+		return -1;
+	}
+	/* The CP fetches microcode and packets from DRAM through the BIMC
+	 * path; the probe leaves this branch on, but a boot without the probe
+	 * must not assume that. */
+	if (scp_branch_on(scp.gcc, CP_GCC_GPU_BIMC_GFX,
+	    "gcc_gpu_bimc_gfx_clk") != 0) {
+		return -1;
+	}
+	if (scp_gdsc_cx() != 0) {
+		return -1;
+	}
+	if (scp_root_clock() != 0) {
+		return -1;
+	}
+	if (scp_gdsc_gx() != 0) {
+		return -1;
+	}
+	if (scp_branch_on(scp.gpucc, CP_GPUCC_GFX3D_CBCR,
+	    "gpucc_gfx3d_clk") != 0) {
+		return -1;
+	}
+
+	ver = scp_rd(scp.kgsl, CP_RBBM_HW_VERSION);
+	printf(CP_PFX "RBBM_HW_VERSION 0x%08x = 0x%08x\n",
+	    CP_KGSL_PA + CP_RBBM_HW_VERSION, ver);
+	if (ver == 0 || ver == 0xffffffffu) {
+		printf(CP_PFX "RBBM does not answer; the GPU window is dead\n");
+		return -1;
+	}
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* The reserved low region (same hole and ADT property the zap uses)   */
+/* ------------------------------------------------------------------ */
+static int
+scp_region_from_adt(uint64_t *pa, vm_size_t *size)
+{
+	DTEntry chosen;
+	uint64_t const *prop = NULL;
+	uint64_t region[2];
+	unsigned int len = 0;
+
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess) {
+		return -1;
+	}
+	if (SecureDTGetProperty(chosen, "sweet-zap-region",
+	    (void const **)&prop, &len) != kSuccess || prop == NULL ||
+	    len < 2 * (unsigned int)sizeof(uint64_t)) {
+		return -1;
+	}
+	/* ADT values are only 4-byte aligned; do not assume an 8-byte load. */
+	memcpy(region, prop, sizeof(region));
+	*pa = region[0];
+	*size = (vm_size_t)region[1];
+	return 0;
+}
+
+static int
+scp_map_low(void)
+{
+	uint64_t end = 0;
+
+	scp.region_pa = CP_REGION_PA_DEFAULT;
+	scp.region_size = CP_REGION_SZ_DEFAULT;
+	scp.region_src = "default";
+	if (scp_region_from_adt(&scp.region_pa, &scp.region_size) == 0) {
+		scp.region_src = "ADT /chosen/sweet-zap-region";
+	}
+	printf(CP_PFX "low region: phys 0x%llx+0x%llx from %s\n",
+	    (unsigned long long)scp.region_pa,
+	    (unsigned long long)scp.region_size, scp.region_src);
+
+	if (scp.region_size < (vm_size_t)(CP_LOW_WIN_OFF + CP_LOW_WIN_SIZE)) {
+		printf(CP_PFX "region is only 0x%llx bytes; the CP window needs "
+		    "0x%llx -- extend /chosen/sweet-zap-region, CP not "
+		    "initialized\n", (unsigned long long)scp.region_size,
+		    (unsigned long long)(CP_LOW_WIN_OFF + CP_LOW_WIN_SIZE));
+		return -1;
+	}
+	if ((scp.region_pa & 0xffffull) != 0) {
+		printf(CP_PFX "region phys 0x%llx is not 64 KiB aligned\n",
+		    (unsigned long long)scp.region_pa);
+		return -1;
+	}
+	if (scp.region_pa < CP_REGION_PA_MIN ||
+	    scp.region_pa + scp.region_size > CP_BELOW_4G) {
+		printf(CP_PFX "region 0x%llx+0x%llx is not below 4 GiB; the CP "
+		    "address space would truncate it\n",
+		    (unsigned long long)scp.region_pa,
+		    (unsigned long long)scp.region_size);
+		return -1;
+	}
+
+	/* The zap buffers live at +0 and +0x100000, 16 KiB each.  Refuse to
+	 * overlap them silently: a clobbered zap image is a TZ fault later. */
+	end = CP_LOW_WIN_OFF + CP_LOW_WIN_SIZE;
+	if (CP_LOW_WIN_OFF < 0x4000ull || end > 0x100000ull) {
+		printf(CP_PFX "CP window +0x%llx..+0x%llx would overlap the zap "
+		    "buffers (+0, +0x100000)\n",
+		    (unsigned long long)CP_LOW_WIN_OFF,
+		    (unsigned long long)end);
+		return -1;
+	}
+
+	scp.win_pa = scp.region_pa + CP_LOW_WIN_OFF;
+	scp.low = ml_io_map_wcomb((vm_offset_t)scp.win_pa, CP_LOW_WIN_SIZE);
+	if (scp.low == 0) {
+		printf(CP_PFX "ml_io_map_wcomb(0x%llx, 0x%x) failed; CP not "
+		    "initialized\n", (unsigned long long)scp.win_pa,
+		    CP_LOW_WIN_SIZE);
+		return -1;
+	}
+
+	scp.pfp_pa = scp.win_pa + CP_PFP_OFF;
+	scp.pm4_pa = scp.win_pa + CP_PM4_OFF;
+	scp.ring_pa = scp.win_pa + CP_RING_OFF;
+	scp.ib_pa = scp.win_pa + CP_IB_OFF;
+	scp.scratch_pa = scp.win_pa + CP_SCRATCH_OFF;
+	printf(CP_PFX "windows: cp phys 0x%llx (va 0x%llx), pfp 0x%llx, pm4 "
+	    "0x%llx, ring 0x%llx, ib 0x%llx, scratch 0x%llx\n",
+	    (unsigned long long)scp.win_pa, (unsigned long long)scp.low,
+	    (unsigned long long)scp.pfp_pa, (unsigned long long)scp.pm4_pa,
+	    (unsigned long long)scp.ring_pa, (unsigned long long)scp.ib_pa,
+	    (unsigned long long)scp.scratch_pa);
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Firmware copy: kgsl _load_firmware() copies &fw->data[4], size - 4   */
+/* ------------------------------------------------------------------ */
+static int
+scp_copy_one(const struct sweet_cp_fw *fw, uint64_t pa, const char *what)
+{
+	const unsigned char *src;
+	vm_size_t len;
+	unsigned char *dst;
+	uint32_t hdr[5];
+
+	if (fw->size <= 4 || (fw->size & 3) != 0) {
+		printf(CP_PFX "%s: %lu bytes is not a firmware file\n", what,
+		    fw->size);
+		return -1;
+	}
+	len = (vm_size_t)fw->size - 4;
+	if (len < sizeof(hdr) || len > CP_SLOT_SIZE) {
+		printf(CP_PFX "%s: image %lu bytes, outside the %lu..0x%x byte "
+		    "range this slot accepts\n", what, (unsigned long)len,
+		    (unsigned long)sizeof(hdr), CP_SLOT_SIZE);
+		return -1;
+	}
+	src = fw->data + 4;
+	dst = (unsigned char *)(scp.low + (pa - scp.win_pa));
+	memcpy(dst, src, len);
+	__asm__ volatile("dsb sy" ::: "memory");
+	if (memcmp(dst, src, len) != 0) {
+		printf(CP_PFX "%s: readback MISMATCH at phys 0x%llx; the region "
+		    "does not hold the image\n", what,
+		    (unsigned long long)pa);
+		return -1;
+	}
+
+	/* The generated array is a byte array: do not assume 4-byte alignment. */
+	memcpy(hdr, src, sizeof(hdr));
+	printf(CP_PFX "%s: %lu byte file, image %lu bytes copied from +4 to "
+	    "phys 0x%llx, version 0x%08x, table 0x%x, first %08x %08x %08x, "
+	    "sha256 %s\n", what, fw->size, (unsigned long)len,
+	    (unsigned long long)pa, hdr[0], hdr[1], hdr[2], hdr[3], hdr[4],
+	    fw->sha256);
+	if ((uint64_t)hdr[1] * 4u + 128u * 4u != (uint64_t)len) {
+		printf(CP_PFX "%s: header says the jump table starts at image "
+		    "dword 0x%x, which does not leave the expected 128-dword "
+		    "table in a %lu byte image\n", what, hdr[1],
+		    (unsigned long)len);
+		return -1;
+	}
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Ring and IB                                                         */
+/* ------------------------------------------------------------------ */
+static void
+scp_put(uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(scp.low + off) = val;
+}
+
+static void
+scp_build(void)
+{
+	static const uint32_t me_init[8] = {
+		0x0000002fu,	/* enabled ordinal mask: max ctx, error det,
+				 * header dump, default reset state, ucode
+				 * workarounds (CP_INIT_MASK) */
+		0x00000003u,	/* multiple hardware contexts: 3D and 2D */
+		0x20000000u,	/* error detection control */
+		0x00000000u,	/* header dump address */
+		0x00000000u,	/* header dump enable / size */
+		0x00000000u,	/* ucode workarounds: a540v2 (patchid 1)
+				 * needs none; a540v1 would use 0x0a */
+		0x00000000u,
+		0x00000000u,
+	};
+	uint32_t i;
+
+	/* The whole ring, both packets, before the CP is started: the CP may
+	 * prefetch, and nothing behind WPTR is written after ME_HALT drops. */
+	for (i = 0; i < CP_RING_DWORDS; ++i) {
+		scp_put(CP_RING_OFF + i * 4, 0);
+	}
+	for (i = 0; i < CP_IB_BYTES / 4; ++i) {
+		scp_put(CP_IB_OFF + i * 4, 0);
+	}
+	scp_put(CP_SCRATCH_OFF, 0);
+
+	/* dwords 0..8: CP_ME_INIT(8) */
+	scp_put(CP_RING_OFF + 0 * 4, scp_pkt7(CP_ME_INIT, 8));
+	for (i = 0; i < 8; ++i) {
+		scp_put(CP_RING_OFF + (1 + i) * 4, me_init[i]);
+	}
+
+	/* dwords 9..12: CP_INDIRECT_BUFFER_PFE to the IB, size in dwords */
+	scp_put(CP_RING_OFF + 9 * 4, scp_pkt7(CP_INDIRECT_BUFFER_PFE, 3));
+	scp_put(CP_RING_OFF + 10 * 4, (uint32_t)scp.ib_pa);
+	scp_put(CP_RING_OFF + 11 * 4, (uint32_t)(scp.ib_pa >> 32));
+	scp_put(CP_RING_OFF + 12 * 4, 4);
+
+	/* IB dword 0..3: CP_MEM_WRITE(3) of CP_MAGIC to the scratch page */
+	scp_put(CP_IB_OFF + 0 * 4, scp_pkt7(CP_MEM_WRITE, 3));
+	scp_put(CP_IB_OFF + 1 * 4, (uint32_t)scp.scratch_pa);
+	scp_put(CP_IB_OFF + 2 * 4, (uint32_t)(scp.scratch_pa >> 32));
+	scp_put(CP_IB_OFF + 3 * 4, CP_MAGIC);
+
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	printf(CP_PFX "ring @0x%llx: %08x %08x %08x %08x %08x %08x %08x %08x "
+	    "%08x | %08x %08x %08x %08x\n", (unsigned long long)scp.ring_pa,
+	    scp_pkt7(CP_ME_INIT, 8), me_init[0], me_init[1], me_init[2],
+	    me_init[3], me_init[4], me_init[5], me_init[6], me_init[7],
+	    scp_pkt7(CP_INDIRECT_BUFFER_PFE, 3), (uint32_t)scp.ib_pa,
+	    (uint32_t)(scp.ib_pa >> 32), 4);
+	printf(CP_PFX "ib   @0x%llx: %08x %08x %08x %08x (CP_MEM_WRITE "
+	    "0x%08x -> scratch 0x%llx)\n", (unsigned long long)scp.ib_pa,
+	    scp_pkt7(CP_MEM_WRITE, 3), (uint32_t)scp.scratch_pa,
+	    (uint32_t)(scp.scratch_pa >> 32), CP_MAGIC, CP_MAGIC,
+	    (unsigned long long)scp.scratch_pa);
+}
+
+/* ------------------------------------------------------------------ */
+/* SMMU: read-only.  No SMR/S2CR/CBAR write happens in this stage.     */
+/* ------------------------------------------------------------------ */
+static void
+scp_smmu_peek(void)
+{
+	static const char *stype[4] = { "abort", "bypass", "stage1", "stage2" };
+	uint32_t scr0 = scp_rd(scp.smmu, CP_SMMU_sCR0);
+	uint32_t s2[4];
+	unsigned i;
+
+	for (i = 0; i < 4; ++i) {
+		s2[i] = scp_rd(scp.smmu, CP_SMMU_S2CR(i));
+	}
+	printf(CP_PFX "SMMU (read-only): sCR0 0x%08x SMMUEN=%u CLIENTPD=%u; "
+	    "S2CR0..3 %08x %08x %08x %08x (STYPE %s/%s/%s/%s)\n", scr0,
+	    (scr0 >> 1) & 1u, scr0 & 1u, s2[0], s2[1], s2[2], s2[3],
+	    stype[s2[0] & 3u], stype[s2[1] & 3u], stype[s2[2] & 3u],
+	    stype[s2[3] & 3u]);
+	printf(CP_PFX "SMMU: this stage programs nothing.  If SMMUEN=1 and the "
+	    "GPU's stream IDs are not bypass, the CP's physical addresses are "
+	    "translated and the microcode fetch faults\n");
+}
+
+/* ------------------------------------------------------------------ */
+/* Error-register snapshot / dump                                      */
+/* ------------------------------------------------------------------ */
+static const char *
+scp_ahb_access(uint32_t v)
+{
+	static const char *names[16] = {
+		"reserved", "reserved", "timestamp lo", "timestamp hi",
+		"pfp read", "pfp write", "", "",
+		"me read", "me write", "", "",
+		"crashdump read", "crashdump write", "", "",
+	};
+
+	return names[(v >> 24) & 0xfu];
+}
+
+static void
+scp_dump(void)
+{
+	uint32_t status = scp_rd(scp.kgsl, CP_RBBM_STATUS);
+	uint32_t ahb_err = scp_rd(scp.kgsl, CP_RBBM_AHB_ERR_STATUS);
+	uint32_t cp_int = scp_rd(scp.kgsl, CP_INTERRUPT_STATUS);
+	uint32_t hw = scp_rd(scp.kgsl, CP_HW_FAULT);
+	uint32_t ahb = scp_rd(scp.kgsl, CP_AHB_FAULT);
+	uint32_t prot = scp_rd(scp.kgsl, CP_PROTECT_STATUS);
+	uint32_t gfsr = scp_rd(scp.smmu, CP_SMMU_sGFSR);
+
+	printf(CP_PFX "RBBM_STATUS 0x%08x (CP_BUSY=%u GPU_BUSY_CP=%u)\n",
+	    status, (status & CP_STATUS_CP_BUSY) ? 1u : 0u,
+	    (status & CP_STATUS_GPU_BUSY_CP) ? 1u : 0u);
+	printf(CP_PFX "CP_INTERRUPT_STATUS 0x%08x (opcode=%u reserved=%u "
+	    "hw_fault=%u dma=%u protect=%u ahb=%u)\n", cp_int,
+	    (cp_int & CP_INT_OPCODE) ? 1u : 0u,
+	    (cp_int & CP_INT_RESERVED) ? 1u : 0u,
+	    (cp_int & CP_INT_HW_FAULT) ? 1u : 0u,
+	    (cp_int & CP_INT_DMA) ? 1u : 0u,
+	    (cp_int & CP_INT_PROTECT) ? 1u : 0u,
+	    (cp_int & CP_INT_AHB) ? 1u : 0u);
+	printf(CP_PFX "CP_HW_FAULT 0x%08x CP_AHB_FAULT 0x%08x "
+	    "(addr 0x%x access=%s error=%u) CP_PROTECT_STATUS 0x%08x\n",
+	    hw, ahb, ahb & 0xfffffu, scp_ahb_access(ahb), (ahb >> 31) & 1u,
+	    prot);
+	printf(CP_PFX "RBBM_AHB_ERROR_STATUS 0x%08x (before 0x%08x) "
+	    "RBBM_AHB_ERROR 0x%08x ME_SPLIT 0x%08x PFP_SPLIT 0x%08x\n",
+	    ahb_err, scp.ahb_err0, scp_rd(scp.kgsl, CP_RBBM_AHB_ERROR),
+	    scp_rd(scp.kgsl, CP_RBBM_ME_SPLIT),
+	    scp_rd(scp.kgsl, CP_RBBM_PFP_SPLIT));
+	printf(CP_PFX "CP_IB1_BASE 0x%08x%08x BUFSZ %u CP_ME_STAT_DATA 0x%08x "
+	    "CP_WFI_PEND_CTR %u\n", scp_rd(scp.kgsl, CP_IB1_BASE_HI),
+	    scp_rd(scp.kgsl, CP_IB1_BASE), scp_rd(scp.kgsl, CP_IB1_BUFSZ),
+	    scp_rd(scp.kgsl, CP_ME_STAT_DATA),
+	    scp_rd(scp.kgsl, CP_WFI_PEND_CTR));
+	printf(CP_PFX "RPTR %u WPTR 0x%08x ME_CNTL 0x%08x RB_CNTL 0x%08x instr "
+	    "pfp 0x%08x%08x pm4 0x%08x%08x\n",
+	    scp_rd(scp.kgsl, CP_RB_RPTR), scp_rd(scp.kgsl, CP_RB_WPTR),
+	    scp_rd(scp.kgsl, CP_ME_CNTL), scp_rd(scp.kgsl, CP_RB_CNTL),
+	    scp_rd(scp.kgsl, CP_PFP_INSTR_BASE_HI),
+	    scp_rd(scp.kgsl, CP_PFP_INSTR_BASE_LO),
+	    scp_rd(scp.kgsl, CP_PM4_INSTR_BASE_HI),
+	    scp_rd(scp.kgsl, CP_PM4_INSTR_BASE_LO));
+	printf(CP_PFX "SMMU_sGFSR 0x%08x (before 0x%08x) sCR0 0x%08x\n", gfsr,
+	    scp.gfsr0, scp_rd(scp.smmu, CP_SMMU_sCR0));
+}
+
+/* ------------------------------------------------------------------ */
+/* CP init                                                             */
+/* ------------------------------------------------------------------ */
+static int
+scp_cp_init(void)
+{
+	uint32_t v;
+
+	/* Queue geometry: vendor a5xx_hw_init(), A540/A512 branch.  These
+	 * registers are 0 after reset and kgsl says so in a comment. */
+	if (scp_wr("CP_MEQ_THRESHOLDS", CP_MEQ_THRESHOLDS, 0x00000040u) !=
+	    0x00000040u) {
+		return -1;
+	}
+	if (scp_wr("CP_MERCIU_SIZE", CP_MERCIU_SIZE, 0x00000400u) !=
+	    0x00000400u) {
+		return -1;
+	}
+	if (scp_wr("CP_ROQ_THRESHOLDS_2", CP_ROQ_THRESHOLDS_2,
+	    0x80000060u) != 0x80000060u) {
+		return -1;
+	}
+	if (scp_wr("CP_ROQ_THRESHOLDS_1", CP_ROQ_THRESHOLDS_1,
+	    0x40201b16u) != 0x40201b16u) {
+		return -1;
+	}
+	/* 64-bit GPU addresses (mainline a5xx_hw_init: REG_A5XX_CP_ADDR_MODE_CNTL
+	 * = 1).  All our addresses are below 4 GiB, so the high words are 0,
+	 * but the packet layout (2-dword addresses) depends on this mode. */
+	if (scp_wr("CP_ADDR_MODE_CNTL", CP_ADDR_MODE_CNTL, 0x1u) != 0x1u) {
+		return -1;
+	}
+
+	/* Enable RBBM AHB error reporting so a bad CP fetch is recorded
+	 * (vendor a5xx_hw_init: RBBM_AHB_CNTL0 = 1, AHB_CNTL1 = 0xA6FFFFFF) */
+	(void)scp_wr("RBBM_AHB_CNTL0", CP_RBBM_AHB_CNTL0, 0x00000001u);
+	(void)scp_wr("RBBM_AHB_CNTL1", CP_RBBM_AHB_CNTL1, 0xa6ffffffu);
+
+	/* Microcode: a5xx has no upload, the CP fetches from these bases. */
+	if (scp_wr("CP_PFP_INSTR_BASE_LO", CP_PFP_INSTR_BASE_LO,
+	    (uint32_t)scp.pfp_pa) != (uint32_t)scp.pfp_pa) {
+		return -1;
+	}
+	if (scp_wr("CP_PFP_INSTR_BASE_HI", CP_PFP_INSTR_BASE_HI,
+	    (uint32_t)(scp.pfp_pa >> 32)) != (uint32_t)(scp.pfp_pa >> 32)) {
+		return -1;
+	}
+	if (scp_wr("CP_PM4_INSTR_BASE_LO", CP_PM4_INSTR_BASE_LO,
+	    (uint32_t)scp.pm4_pa) != (uint32_t)scp.pm4_pa) {
+		return -1;
+	}
+	if (scp_wr("CP_PM4_INSTR_BASE_HI", CP_PM4_INSTR_BASE_HI,
+	    (uint32_t)(scp.pm4_pa >> 32)) != (uint32_t)(scp.pm4_pa >> 32)) {
+		return -1;
+	}
+
+	/* 4 KiB ring, 32-byte blocks, RPTR shadow disabled.  RB_CNTL before
+	 * RB_BASE, exactly as kgsl a5xx_rb_start() orders it. */
+	v = CP_RB_CNTL_BUFSZ(9) | CP_RB_CNTL_BLKSZ(2) | CP_RB_CNTL_NO_UPDATE;
+	if (scp_wr("CP_RB_CNTL", CP_RB_CNTL, v) != v) {
+		return -1;
+	}
+	if (scp_wr("CP_RB_BASE", CP_RB_BASE, (uint32_t)scp.ring_pa) !=
+	    (uint32_t)scp.ring_pa) {
+		return -1;
+	}
+	if (scp_wr("CP_RB_BASE_HI", CP_RB_BASE_HI,
+	    (uint32_t)(scp.ring_pa >> 32)) !=
+	    (uint32_t)(scp.ring_pa >> 32)) {
+		return -1;
+	}
+
+	scp.rptr0 = scp_rd(scp.kgsl, CP_RB_RPTR);
+	printf(CP_PFX "RPTR after reset: %u (must be 0)\n", scp.rptr0);
+	if (scp.rptr0 != 0) {
+		printf(CP_PFX "the CP was not reset (RPTR %u); the ring layout "
+		    "would be wrong, stopping\n", scp.rptr0);
+		return -1;
+	}
+	return 0;
+}
+
+static void
+scp_verdict(int me_init_ok, int ib_ok)
+{
+	uint32_t cp_int = scp_rd(scp.kgsl, CP_INTERRUPT_STATUS);
+	uint32_t ahb = scp_rd(scp.kgsl, CP_AHB_FAULT);
+	uint32_t hw = scp_rd(scp.kgsl, CP_HW_FAULT);
+	uint32_t prot = scp_rd(scp.kgsl, CP_PROTECT_STATUS);
+	uint32_t status = scp_rd(scp.kgsl, CP_RBBM_STATUS);
+	uint32_t gfsr = scp_rd(scp.smmu, CP_SMMU_sGFSR);
+
+	if (me_init_ok && ib_ok) {
+		printf(CP_PFX "VERDICT: CP EXECUTED A PACKET -- microcode "
+		    "fetched, ring parsed, IB fetched and CP_MEM_WRITE landed "
+		    "at 0x%llx\n", (unsigned long long)scp.scratch_pa);
+		return;
+	}
+	if (cp_int & CP_INT_AHB) {
+		printf(CP_PFX "VERDICT: CP AHB ERROR -- %s at 0x%x, error=%u. "
+		    "The CP's memory fetch was aborted; with no SMMU programmed "
+		    "this is a translation fault (SMMUEN=1, stream ID not "
+		    "bypass) or a still-secure GPU, not a CP hang\n",
+		    scp_ahb_access(ahb), ahb & 0xfffffu, (ahb >> 31) & 1u);
+		return;
+	}
+	if (cp_int & CP_INT_HW_FAULT) {
+		printf(CP_PFX "VERDICT: CP HW FAULT 0x%08x -- the microcode "
+		    "raised an internal fault\n", hw);
+		return;
+	}
+	if (cp_int & CP_INT_PROTECT) {
+		printf(CP_PFX "VERDICT: CP register protection error 0x%08x -- "
+		    "the microcode tried to write a protected register\n", prot);
+		return;
+	}
+	if (cp_int & CP_INT_OPCODE) {
+		printf(CP_PFX "VERDICT: CP opcode error -- a packet header was "
+		    "rejected\n");
+		return;
+	}
+	if (gfsr != scp.gfsr0) {
+		printf(CP_PFX "VERDICT: SMMU recorded a fault (sGFSR 0x%08x -> "
+		    "0x%08x) -- the CP's physical addresses are being translated\n",
+		    scp.gfsr0, gfsr);
+		return;
+	}
+	if (!(status & (CP_STATUS_CP_BUSY | CP_STATUS_GPU_BUSY_CP)) &&
+	    scp_rd(scp.kgsl, CP_RB_RPTR) == 0) {
+		printf(CP_PFX "VERDICT: CP never started -- no bus error and no "
+		    "progress.  ME_HALT did not clear, or this boot did not run "
+		    "sweetzap=1 so the GPU is still secure and cannot fetch "
+		    "non-secure microcode\n");
+		return;
+	}
+	printf(CP_PFX "VERDICT: CP hung without reporting an error (RPTR %u, "
+	    "CP_BUSY=%u) -- see the dump above\n",
+	    scp_rd(scp.kgsl, CP_RB_RPTR),
+	    (status & CP_STATUS_CP_BUSY) ? 1u : 0u);
+}
+
+static void
+scp_run(void)
+{
+	uint32_t scratch;
+	uint32_t v;
+	int me_init_ok = 0, ib_ok = 0;
+
+	printf(CP_PFX "--- CP bring-up start ---\n");
+
+	if (scp_power_up() != 0) {
+		printf(CP_PFX "--- CP bring-up abandoned: the GPU block is not "
+		    "usable ---\n");
+		return;
+	}
+	if (scp_map_low() != 0) {
+		printf(CP_PFX "--- CP bring-up abandoned: no low region ---\n");
+		return;
+	}
+
+	/* Firmware: table order is pfp, pm4 (sweet_cp_image.c). */
+	if (sweet_a530_cp_fw_count < 2) {
+		printf(CP_PFX "generated firmware table has %lu entries, need 2\n",
+		    sweet_a530_cp_fw_count);
+		return;
+	}
+	if (scp_copy_one(&sweet_a530_cp_fw[0], scp.pfp_pa, "a530_pfp.fw") != 0 ||
+	    scp_copy_one(&sweet_a530_cp_fw[1], scp.pm4_pa, "a530_pm4.fw") != 0) {
+		printf(CP_PFX "--- CP bring-up abandoned: firmware copy ---\n");
+		return;
+	}
+
+	scp_build();
+	scp_smmu_peek();
+
+	scp.ahb_err0 = scp_rd(scp.kgsl, CP_RBBM_AHB_ERR_STATUS);
+	scp.cp_int0 = scp_rd(scp.kgsl, CP_INTERRUPT_STATUS);
+	scp.cp_fault0 = scp_rd(scp.kgsl, CP_HW_FAULT);
+	scp.cp_ahb0 = scp_rd(scp.kgsl, CP_AHB_FAULT);
+	scp.gfsr0 = scp_rd(scp.smmu, CP_SMMU_sGFSR);
+	printf(CP_PFX "baseline: AHB_ERR 0x%08x CP_INT 0x%08x HW_FAULT 0x%08x "
+	    "AHB_FAULT 0x%08x sGFSR 0x%08x\n", scp.ahb_err0, scp.cp_int0,
+	    scp.cp_fault0, scp.cp_ahb0, scp.gfsr0);
+
+	if (scp_cp_init() != 0) {
+		printf(CP_PFX "--- CP bring-up abandoned: register init ---\n");
+		scp_dump();
+		return;
+	}
+
+	/* Un-halt the ME, then hand it the ME_INIT packet.  Bit 0 is ME_HALT;
+	 * the other bits are not part of this stage, so only bit 0 decides. */
+	v = scp_wr("CP_ME_CNTL", CP_ME_CNTL, 0x0u);
+	if (v & 0x1u) {
+		printf(CP_PFX "--- CP bring-up abandoned: ME_HALT did not "
+		    "clear (CP_ME_CNTL 0x%08x) ---\n", v);
+		scp_dump();
+		return;
+	}
+	(void)scp_wr("CP_RB_WPTR (ME_INIT)", CP_RB_WPTR, 9u);
+	if (scp_poll_eq(CP_RB_RPTR, 9u, CP_ME_INIT_TIMEOUT_MS,
+	    "RPTR == 9 (CP_ME_INIT)") == 0) {
+		me_init_ok = 1;
+	} else {
+		printf(CP_PFX "the CP did not consume CP_ME_INIT; the dump "
+		    "below says why\n");
+		scp_dump();
+		scp_verdict(0, 0);
+		return;
+	}
+
+	/* One CP_MEM_WRITE through the IB. */
+	(void)scp_wr("CP_RB_WPTR (IB)", CP_RB_WPTR, 13u);
+	for (unsigned i = 0; i < CP_IB_TIMEOUT_MS; ++i) {
+		scratch = *(volatile uint32_t *)(scp.low + CP_SCRATCH_OFF);
+		__asm__ volatile("dmb oshld" ::: "memory");
+		if (scratch == CP_MAGIC) {
+			printf(CP_PFX "scratch 0x%llx reads 0x%08x (\"CPOK\") "
+			    "after %u ms\n",
+			    (unsigned long long)scp.scratch_pa, scratch, i);
+			ib_ok = 1;
+			break;
+		}
+		delay(1000);
+	}
+	if (!ib_ok) {
+		scratch = *(volatile uint32_t *)(scp.low + CP_SCRATCH_OFF);
+		printf(CP_PFX "scratch 0x%llx still 0x%08x after %u ms\n",
+		    (unsigned long long)scp.scratch_pa, scratch,
+		    CP_IB_TIMEOUT_MS);
+	}
+	printf(CP_PFX "RPTR now %u (wanted 13), WPTR 0x%08x\n",
+	    scp_rd(scp.kgsl, CP_RB_RPTR), scp_rd(scp.kgsl, CP_RB_WPTR));
+
+	scp_dump();
+	scp_verdict(me_init_ok, ib_ok);
+	printf(CP_PFX "--- CP bring-up done (me_init=%d ib=%d) ---\n",
+	    me_init_ok, ib_ok);
+}
+
+/* ------------------------------------------------------------------ */
+/* Thread + entry point                                                */
+/* ------------------------------------------------------------------ */
+static void
+scp_sleep_s(unsigned s)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(s, NSEC_PER_SEC, &deadline);
+	(void)assert_wait_deadline(&scp_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+scp_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	scp_sleep_s(scp.delay_s);
+	scp_run();
+	printf(CP_PFX "thread exiting\n");
+	(void)thread_terminate(current_thread());
+}
+
+void
+sweet_cp_init(void)
+{
+	int enabled = 0;
+	int delay_s = 40;
+	thread_t thread;
+
+	if (scp_started) {
+		return;
+	}
+	scp_started = 1;
+
+	(void)PE_parse_boot_argn("sweetcp", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("sweetcpdelay", &delay_s, sizeof(delay_s));
+
+	if (!enabled) {
+		printf(CP_PFX "disabled (sweetcp=0)\n");
+		return;
+	}
+	if (delay_s < 1) {
+		delay_s = 1;
+	}
+	if (delay_s > 180) {
+		delay_s = 180;
+	}
+	scp.delay_s = (unsigned)delay_s;
+
+	printf(CP_PFX "enabled: CP bring-up in %u s (needs the zap from this "
+	    "boot: sweetzap=1)\n", scp.delay_s);
+
+	kern_return_t kr = kernel_thread_start(scp_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf(CP_PFX "kernel_thread_start failed %d; not run\n", kr);
+	}
+}
+
+#else /* !ARM64_BOARD_CONFIG_SAGIT */
+/*
+ * The addresses above are MSM8998's.  Other boards in this tree (sweet,
+ * SM7150) must not touch them, so the symbol still exists but does nothing.
+ */
+void
+sweet_cp_init(void)
+{
+}
+#endif /* ARM64_BOARD_CONFIG_SAGIT */
