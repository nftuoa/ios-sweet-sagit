+/* ------------------------------------------------------------------ */
+/* 0142 mode 1: read-only RBBM/CP probe                               */
+/*                                                                    */
+/* Prints the canary line BEFORE the read, then the value.  An MMIO   */
+/* read cannot be timed out: if it is aimed at a gated register the   */
+/* CPU (and, on this hypervisor, the interconnect) stops, so the last */
+/* line in the persistent log is the canary of the read that did not  */
+/* return.  Nothing below writes any register, and the SMMU is never  */
+/* mapped.                                                            */
+/* ------------------------------------------------------------------ */
+static uint32_t
+scp_probe_read(const char *name, uint32_t off)
+{
+	uint32_t v;
+
+	scp.probe_reads++;
+	printf(CP_PFX "probe  %-26s [0x%05x] phys 0x%08x ...\n", name, off,
+	    CP_KGSL_PA + off);
+	__asm__ volatile("dsb sy" ::: "memory");
+	v = scp_rd(scp.kgsl, off);
+	printf(CP_PFX "  -->  %-26s [0x%05x] = 0x%08x\n", name, off, v);
+	__asm__ volatile("dsb sy" ::: "memory");
+	return v;
+}
+
+static void
+scp_probe_run(void)
+{
+	uint32_t v, ver;
+
+	printf(CP_PFX "--- read-only RBBM/CP probe start (no writes, SMMU not "
+	    "mapped) ---\n");
+	scp.kgsl = ml_io_map(CP_KGSL_PA, CP_KGSL_SZ);
+	if (scp.kgsl == 0) {
+		printf(CP_PFX "probe: ml_io_map(0x%08x, 0x%x) failed; nothing "
+		    "touched\n", CP_KGSL_PA, CP_KGSL_SZ);
+		return;
+	}
+	printf(CP_PFX "probe: mapped kgsl 0x%08x+0x%x at va 0x%lx read-only\n",
+	    CP_KGSL_PA, CP_KGSL_SZ, (unsigned long)scp.kgsl);
+
+	/* The first read is also the liveness gate.  If the window is not
+	 * clocked the whole probe is pointless and, worse, every later read
+	 * may wedge; stop here and say why. */
+	ver = scp_probe_read("RBBM_HW_VERSION", CP_RBBM_HW_VERSION);
+	if (ver == 0 || ver == 0xffffffffu) {
+		printf(CP_PFX "probe: RBBM does not answer (0x%08x); the GPU "
+		    "window is not clocked.  Boot sweetgpuprobe=1 first (it is "
+		    "what leaves the GDSCs and gfx3d root clock on).  Stopping "
+		    "before any other read.\n", ver);
+		return;
+	}
+
+	v = scp_probe_read("RBBM_STATUS", CP_RBBM_STATUS);
+	printf(CP_PFX "  RBBM_STATUS: GPU_BUSY_IGN_AHB=%u "
+	    "GPU_BUSY_IGN_AHB_CP=%u CP_BUSY=%u CP_ME_BUSY=%u CP_PFP_BUSY=%u "
+	    "CP_ETS_BUSY=%u.  There is no RBBM_GPU_BUSY register on A5xx; "
+	    "the \"GPU busy\" signals are bits 31/30 of this word.\n",
+	    (v & CP_STATUS_GPU_BUSY) ? 1u : 0u,
+	    (v & CP_STATUS_GPU_BUSY_CP) ? 1u : 0u,
+	    (v & CP_STATUS_CP_BUSY) ? 1u : 0u,
+	    (v & CP_STATUS_CP_ME_BUSY) ? 1u : 0u,
+	    (v & CP_STATUS_CP_PFP_BUSY) ? 1u : 0u,
+	    (v & CP_STATUS_CP_ETS_BUSY) ? 1u : 0u);
+
+	v = scp_probe_read("RBBM_STATUS3", CP_RBBM_STATUS3);
+	printf(CP_PFX "  RBBM_STATUS3: SMMU_STALLED_ON_FAULT=%u\n",
+	    (v & CP_STATUS3_SMMU_STALL) ? 1u : 0u);
+
+	(void)scp_probe_read("RBBM_AHB_ERROR_STATUS", CP_RBBM_AHB_ERR_STATUS);
+	(void)scp_probe_read("RBBM_AHB_ERROR", CP_RBBM_AHB_ERROR);
+	(void)scp_probe_read("RBBM_AHB_CNTL0", CP_RBBM_AHB_CNTL0);
+	(void)scp_probe_read("RBBM_AHB_CNTL1", CP_RBBM_AHB_CNTL1);
+	(void)scp_probe_read("RBBM_AHB_CNTL2", CP_RBBM_AHB_CNTL2);
+	(void)scp_probe_read("RBBM_AHB_ME_SPLIT", CP_RBBM_ME_SPLIT);
+	(void)scp_probe_read("RBBM_AHB_PFP_SPLIT", CP_RBBM_PFP_SPLIT);
+
+	/* Ring buffer block. */
+	(void)scp_probe_read("CP_RB_BASE", CP_RB_BASE);
+	(void)scp_probe_read("CP_RB_BASE_HI", CP_RB_BASE_HI);
+	v = scp_probe_read("CP_RB_CNTL", CP_RB_CNTL);
+	printf(CP_PFX "  CP_RB_CNTL: BUFSZ=%u BLKSZ=%u NO_UPDATE=%u "
+	    "(BUFSZ = log2(ring bytes/8), BLKSZ = log2(block bytes/8))\n",
+	    v & 0x3fu, (v >> 8) & 0x1fu, (v >> 15) & 1u);
+	(void)scp_probe_read("CP_RB_RPTR", CP_RB_RPTR);
+	(void)scp_probe_read("CP_RB_WPTR", CP_RB_WPTR);
+
+	/* Queues: thresholds and their debug windows. */
+	(void)scp_probe_read("CP_PFP_STAT_ADDR", CP_PFP_STAT_ADDR);
+	(void)scp_probe_read("CP_PFP_STAT_DATA", CP_PFP_STAT_DATA);
+	(void)scp_probe_read("CP_ROQ_THRESHOLDS_1", CP_ROQ_THRESHOLDS_1);
+	(void)scp_probe_read("CP_ROQ_THRESHOLDS_2", CP_ROQ_THRESHOLDS_2);
+	(void)scp_probe_read("CP_ROQ_DBG_ADDR", CP_ROQ_DBG_ADDR);
+	(void)scp_probe_read("CP_ROQ_DBG_DATA", CP_ROQ_DBG_DATA);
+	(void)scp_probe_read("CP_MEQ_DBG_ADDR", CP_MEQ_DBG_ADDR);
+	(void)scp_probe_read("CP_MEQ_DBG_DATA", CP_MEQ_DBG_DATA);
+	(void)scp_probe_read("CP_MEQ_THRESHOLDS", CP_MEQ_THRESHOLDS);
+	(void)scp_probe_read("CP_MERCIU_SIZE", CP_MERCIU_SIZE);
+
+	/* Microcode bases and ME state. */
+	(void)scp_probe_read("CP_ME_CNTL", CP_ME_CNTL);
+	v = scp_probe_read("CP_ME_STAT_ADDR", CP_ME_STAT_ADDR);
+	printf(CP_PFX "  CP_ME_STAT_ADDR: 0x%08x\n", v);
+	(void)scp_probe_read("CP_PFP_INSTR_BASE_LO", CP_PFP_INSTR_BASE_LO);
+	(void)scp_probe_read("CP_PFP_INSTR_BASE_HI", CP_PFP_INSTR_BASE_HI);
+	(void)scp_probe_read("CP_PM4_INSTR_BASE_LO", CP_PM4_INSTR_BASE_LO);
+	(void)scp_probe_read("CP_PM4_INSTR_BASE_HI", CP_PM4_INSTR_BASE_HI);
+	(void)scp_probe_read("CP_ADDR_MODE_CNTL", CP_ADDR_MODE_CNTL);
+	(void)scp_probe_read("CP_PROTECT_CNTL", CP_PROTECT_CNTL);
+
+	/* Status / fault registers. */
+	(void)scp_probe_read("CP_ME_STAT_DATA", CP_ME_STAT_DATA);
+	(void)scp_probe_read("CP_WFI_PEND_CTR", CP_WFI_PEND_CTR);
+	v = scp_probe_read("CP_INTERRUPT_STATUS", CP_INTERRUPT_STATUS);
+	printf(CP_PFX "  CP_INTERRUPT_STATUS: opcode=%u reserved=%u "
+	    "hw_fault=%u dma=%u protect=%u ahb=%u\n",
+	    (v & CP_INT_OPCODE) ? 1u : 0u,
+	    (v & CP_INT_RESERVED) ? 1u : 0u,
+	    (v & CP_INT_HW_FAULT) ? 1u : 0u,
+	    (v & CP_INT_DMA) ? 1u : 0u,
+	    (v & CP_INT_PROTECT) ? 1u : 0u,
+	    (v & CP_INT_AHB) ? 1u : 0u);
+	(void)scp_probe_read("CP_HW_FAULT", CP_HW_FAULT);
+	v = scp_probe_read("CP_AHB_FAULT", CP_AHB_FAULT);
+	printf(CP_PFX "  CP_AHB_FAULT: addr 0x%05x access=%s error=%u\n",
+	    v & 0xfffffu, scp_ahb_access(v), (v >> 31) & 1u);
+	(void)scp_probe_read("CP_PROTECT_STATUS", CP_PROTECT_STATUS);
+	(void)scp_probe_read("CP_IB1_BASE", CP_IB1_BASE);
+	(void)scp_probe_read("CP_IB1_BASE_HI", CP_IB1_BASE_HI);
+	(void)scp_probe_read("CP_IB1_BUFSZ", CP_IB1_BUFSZ);
+
+	/* SECVID last: before the zap this exact read is known to wedge the
+	 * bus, and every other answer is already in the log by now. */
+	if (scp.probe_secvid) {
+		printf(CP_PFX "probe: last read is RBBM_SECVID_TRUST_CNTL.  It "
+		    "is only readable after the zap has released the GPU; if "
+		    "the log stops after the next line, this boot had no "
+		    "working zap (or set sweetcpprobesecvid=0).\n");
+		v = scp_probe_read("RBBM_SECVID_TRUST_CNTL",
+		    CP_RBBM_SECVID_TRUST);
+		printf(CP_PFX "  RBBM_SECVID_TRUST_CNTL: 0x%08x (%s)\n", v,
+		    v == 1u ? "GPU released from secure mode" :
+		    "not the post-zap value 1; still secure or unexpected");
+	} else {
+		printf(CP_PFX "probe: RBBM_SECVID_TRUST_CNTL skipped "
+		    "(sweetcpprobesecvid=0)\n");
+	}
+
+	printf(CP_PFX "probe: done: %u reads returned, no register written "
+	    "(the SMMU was never mapped)\n", scp.probe_reads);
+}
+
+/* ------------------------------------------------------------------ */
+/* 0142 mode 2: write bisect -- exactly one CP register write         */
+/*                                                                    */
+/* Each boot performs one of the 0141 init writes, after the same     */
+/* DRAM setup (firmware copy, ring build) and the same idempotent     */
+/* power-up, then stops.  Index 15 is the one exception: clearing     */
+/* ME_HALT with CP_PFP/PM4_INSTR_BASE still 0 would start the CP at   */
+/* physical 0, so that index programs the four instruction bases      */
+/* first and says so in the log.  The tested write is still only the  */
+/* CP_ME_CNTL one; the bases are prerequisites that indices 8..11     */
+/* test on their own.                                                 */
+/* ------------------------------------------------------------------ */
+static int
+scp_bisect_target(int idx, const char **name, uint32_t *off, uint32_t *val)
+{
+	switch (idx) {
+	case 1:
+		*name = "CP_MEQ_THRESHOLDS";
+		*off = CP_MEQ_THRESHOLDS;
+		*val = 0x00000040u;
+		break;
+	case 2:
+		*name = "CP_MERCIU_SIZE";
+		*off = CP_MERCIU_SIZE;
+		*val = 0x00000400u;
+		break;
+	case 3:
+		*name = "CP_ROQ_THRESHOLDS_2";
+		*off = CP_ROQ_THRESHOLDS_2;
+		*val = 0x80000060u;
+		break;
+	case 4:
+		*name = "CP_ROQ_THRESHOLDS_1";
+		*off = CP_ROQ_THRESHOLDS_1;
+		*val = 0x40201b16u;
+		break;
+	case 5:
+		*name = "CP_ADDR_MODE_CNTL";
+		*off = CP_ADDR_MODE_CNTL;
+		*val = 0x00000001u;
+		break;
+	case 6:
+		*name = "RBBM_AHB_CNTL0";
+		*off = CP_RBBM_AHB_CNTL0;
+		*val = 0x00000001u;
+		break;
+	case 7:
+		*name = "RBBM_AHB_CNTL1";
+		*off = CP_RBBM_AHB_CNTL1;
+		*val = 0xa6ffffffu;
+		break;
+	case 8:
+		*name = "CP_PFP_INSTR_BASE_LO";
+		*off = CP_PFP_INSTR_BASE_LO;
+		*val = (uint32_t)scp.pfp_pa;
+		break;
+	case 9:
+		*name = "CP_PFP_INSTR_BASE_HI";
+		*off = CP_PFP_INSTR_BASE_HI;
+		*val = (uint32_t)(scp.pfp_pa >> 32);
+		break;
+	case 10:
+		*name = "CP_PM4_INSTR_BASE_LO";
+		*off = CP_PM4_INSTR_BASE_LO;
+		*val = (uint32_t)scp.pm4_pa;
+		break;
+	case 11:
+		*name = "CP_PM4_INSTR_BASE_HI";
+		*off = CP_PM4_INSTR_BASE_HI;
+		*val = (uint32_t)(scp.pm4_pa >> 32);
+		break;
+	case 12:
+		*name = "CP_RB_CNTL";
+		*off = CP_RB_CNTL;
+		*val = CP_RB_CNTL_BUFSZ(9) | CP_RB_CNTL_BLKSZ(2) |
+		    CP_RB_CNTL_NO_UPDATE;
+		break;
+	case 13:
+		*name = "CP_RB_BASE";
+		*off = CP_RB_BASE;
+		*val = (uint32_t)scp.ring_pa;
+		break;
+	case 14:
+		*name = "CP_RB_BASE_HI";
+		*off = CP_RB_BASE_HI;
+		*val = (uint32_t)(scp.ring_pa >> 32);
+		break;
+	case 15:
+		*name = "CP_ME_CNTL";
+		*off = CP_ME_CNTL;
+		*val = 0x00000000u;
+		break;
+	case 16:
+		*name = "CP_RB_WPTR (CP_ME_INIT doorbell)";
+		*off = CP_RB_WPTR;
+		*val = 9u;
+		break;
+	case 17:
+		*name = "CP_RB_WPTR (IB doorbell)";
+		*off = CP_RB_WPTR;
+		*val = 13u;
+		break;
+	default:
+		return -1;
+	}
+	return 0;
+}
+
+static void
+scp_bisect_prewrite(const char *name, uint32_t off, uint32_t val)
+{
+	printf(CP_PFX "bisect: prerequisite write %s [0x%05x] = 0x%08x "
+	    "(only for index 15; the ME must not start at physical 0)\n",
+	    name, off, val);
+	__asm__ volatile("dsb sy" ::: "memory");
+	scp_wr_raw(scp.kgsl, off, val);
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf(CP_PFX "bisect: prerequisite %s reads back 0x%08x\n", name,
+	    scp_rd(scp.kgsl, off));
+}
+
+static void
+scp_bisect_run(int idx)
+{
+	const char *name = "?";
+	uint32_t off = 0, val = 0, rb;
+
+	printf(CP_PFX "--- CP write bisect start: index %d, one tested write ---\n",
+	    idx);
+
+	/* DRAM setup first: it needs no GPU power and makes the instruction
+	 * base / ring addresses in the table real.  These are memcpy()s, not
+	 * register writes. */
+	if (scp_map_low() != 0) {
+		printf(CP_PFX "bisect: no low region; nothing written\n");
+		return;
+	}
+	if (sweet_a530_cp_fw_count < 2) {
+		printf(CP_PFX "bisect: generated firmware table has %lu entries, "
+		    "need 2\n", sweet_a530_cp_fw_count);
+		return;
+	}
+	if (scp_copy_one(&sweet_a530_cp_fw[0], scp.pfp_pa, "a530_pfp.fw") != 0
+	    || scp_copy_one(&sweet_a530_cp_fw[1], scp.pm4_pa,
+	    "a530_pm4.fw") != 0) {
+		printf(CP_PFX "bisect: firmware copy failed; nothing written\n");
+		return;
