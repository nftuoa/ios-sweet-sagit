+/*
+ * 0138 discrimination test, opt-in with sweetzapbogus=1: call init_image on
+ * the same low address with the first 16 bytes (including the ELF magic)
+ * zeroed, then restore the whole run and call init_image for real.
+ *
+ * The high-address attempt failed with r0=0xfffffffffffffff6 before any
+ * verdict was produced.  If the monitor can now read the low address, the
+ * zeroed header should come back as a *PAS verdict* (r0=0, r1!=0) instead of
+ * a transport error.  That is the difference between "the address is
+ * unreadable" and "the image is not acceptable", which the real call alone
+ * cannot distinguish.  If the monitor accepts the zeroed header, release the
+ * PAS state it just created before the real init_image, or the real call
+ * would see EBUSY.
+ */
+static int
+sweet_zap_bogus_test(uint64_t mask, const char *tag)
+{
+	struct sweet_scm_ret r;
+	uint8_t *buf = (uint8_t *)zap.va;
+	int ret;
+
+	printf(ZAP_PFX "bogus test: zeroing the first 16 bytes at phys 0x%llx "
+	    "(ELF magic included) and calling init_image\n",
+	    (unsigned long long)zap.pa);
+
+	memset(buf, 0, 16);
+	__asm__ volatile("dsb sy" ::: "memory");
+	flush_dcache64((addr64_t)zap.va, 16, FALSE);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	ret = sweet_zap_issue(mask, tag, "init_image(bogus)",
+	    SCM_PAS_INIT_IMAGE, SCM_ARGS2_VAL_RW, SCM_PAS_ID_GPU_ZAP,
+	    (uint64_t)zap.pa, 0, &r);
+
+	if (ret != 0) {
+		printf(ZAP_PFX "bogus test verdict: r0=0x%llx (%s) r1=0x%llx -- "
+		    "a transport error, not a PAS image verdict; the address is "
+		    "still a suspect (compare this r0 with the high-address "
+		    "run)\n", (unsigned long long)r.r0,
+		    sweet_scm_r0_name(r.r0), (unsigned long long)r.r1);
+	} else if (r.r1 != 0) {
+		printf(ZAP_PFX "bogus test verdict: r0=0 r1=0x%llx -- the monitor "
+		    "read the low address and rejected the zeroed image.  The "
+		    "address is no longer the problem; ordinary errors now come "
+		    "back as a PAS verdict\n", (unsigned long long)r.r1);
+	} else {
+		printf(ZAP_PFX "bogus test verdict: r0=0 r1=0 -- the monitor "
+		    "accepted a zeroed header, so init_image does not validate "
+		    "the magic; releasing that PAS state before the real call\n");
+	}
+
+	/*
+	 * Restore the whole run, not just the 16 zeroed bytes: arginfo is RW,
+	 * so the monitor is allowed to have written anywhere in it.  Then
+	 * verify the header the real call will see.
+	 */
+	bzero(buf, zap.alloc);
+	memcpy(buf, sweet_a540_zap_image, (size_t)zap.len);
+	__asm__ volatile("dsb sy" ::: "memory");
+	flush_dcache64((addr64_t)zap.va, (unsigned)zap.alloc, FALSE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	if (memcmp(buf, sweet_a540_zap_image, 16) != 0) {
+		printf(ZAP_PFX "bogus test: could not restore the ELF header; "
+		    "PAS not called\n");
+		return -1;
+	}
+
+	if (ret == 0 && r.r1 == 0) {
+		ret = sweet_zap_issue(mask, tag, "shutdown", SCM_PAS_SHUTDOWN,
+		    SCM_ARGS1, SCM_PAS_ID_GPU_ZAP, 0, 0, &r);
+		if (ret != 0 || r.r1 != 0) {
+			printf(ZAP_PFX "bogus test: shutdown after the accepted "
+			    "bogus call failed (r0=0x%llx, r1=0x%llx); the real "
+			    "init_image may see EBUSY\n",
+			    (unsigned long long)r.r0,
+			    (unsigned long long)r.r1);
+		}
+	}
+
+	return 0;
+}
