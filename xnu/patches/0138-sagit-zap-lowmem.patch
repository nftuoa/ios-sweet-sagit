+/* 16 bytes as 32 lowercase hex digits, for the readback line. */
+static void
+zap_hex16(const uint8_t *p, char out[33])
+{
+	static const char digits[] = "0123456789abcdef";
+	int i;
+
+	for (i = 0; i < 16; i++) {
+		out[i * 2] = digits[p[i] >> 4];
+		out[i * 2 + 1] = digits[p[i] & 0x0f];
+	}
+	out[32] = '\0';
+}
