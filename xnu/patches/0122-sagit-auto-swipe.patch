+void
+SweetHIDButtons::autoUnlockFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetHIDButtons *self = (SweetHIDButtons *)owner;
+	UInt32 clients = (UInt32)(self->_clients ? self->_clients->getCount() : 0);
+
+	IOLog("SWEET HID: auto-unlock tick %u (touch=%d clients=%u)\n",
+	    (unsigned)++self->fAutoUnlockTicks, gSweetTouch != NULL, (unsigned)clients);
+	/*
+	 * The gesture is only meaningful once backboardd reads our events; the
+	 * timer keeps running regardless so a late lock screen is still caught.
+	 */
+	if (gSweetTouch != NULL && clients != 0) {
+		gSweetTouch->swipeUp();
+	}
+	sender->setTimeoutMS(self->fAutoUnlockSecs * 1000);
+}
