+	 * crash loop starves it), so the lock screen can be missed entirely.
+	 * An IOTimerEventSource fires on the HID workloop with tick accuracy and
+	 * keeps trying until the screen is actually unlocked.
+	 */
+	static void autoUnlockFired(OSObject *owner, IOTimerEventSource *sender);
+	IOTimerEventSource *fAutoUnlock;
