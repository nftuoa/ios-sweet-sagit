+/*
+ * Display wake from the HID path: a touch while the panel is off means the
+ * user is trying to use the phone.  SpringBoard turned the display off itself
+ * (RequestPowerChange 0) and only a power-key press turns it back on, so the
+ * touch driver calls this to clear the off state (the frame that was kept on
+ * screen is shown again) and then sends a synthetic power key.
+ */
+void
+AppleCLCD::noteWake(void)
+{
+	IOLockLock(fLock);
+	if (fPowerOff) {
+		fPowerOff = false;
+		fFadeStep = 0;
+		fDirty = true;
+	}
+	IOLockUnlock(fLock);
+}
+
+bool
+sweet_fb_display_is_off(void)
+{
+	return gSweetFBInstance != NULL && gSweetFBInstance->displayIsOff();
+}
+
+void
+sweet_fb_note_wake(void)
+{
+	if (gSweetFBInstance != NULL) {
+		gSweetFBInstance->noteWake();
+	}
+}
