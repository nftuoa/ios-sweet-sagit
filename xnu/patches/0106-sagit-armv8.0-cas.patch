diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index da0bbba..83e5fe1 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -251,6 +251,26 @@ _jump_table:				// 32 entry jump table, only 2 are used
  * } osfifoqueuehead;
  */
 
+/*
+ * ARMv8.0 cores (Kryo 280 on the Xiaomi Mi 6) have no LSE atomics, so the
+ * acquire-release compare-and-swap Apple writes as CASA needs an exclusive
+ * load/store pair.  Leaves the observed value in \expected and the exclusive
+ * status in \status, with the same semantics as CASA \expected, \new, [\addr].
+ */
+.macro CAS_ACQREL expected, new, addr, status
+#if defined(ARM64_BOARD_CONFIG_SAGIT)
+	mov	\status, \expected
+1:	ldaxr	\expected, [\addr]
+	cmp	\expected, \status
+	b.ne	2f
+	stlxr	\status, \new, [\addr]
+	cbnz	\status, 1b
+2:
+#else
+	casa	\expected, \new, [\addr]
+#endif
+.endmacro
+
 /* Non-preemptible helper routine to FIFO enqueue:
  * int pfz_trylock_and_enqueue(OSFifoQueueHead *__list, void *__new, size_t __offset, uint32_t *lock_addr);
  *
@@ -273,7 +293,7 @@ _pfz_trylock_and_enqueue:
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
-	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+	CAS_ACQREL w10, w11, x3, w12	 // Atomic CAS with acquire barrier
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
@@ -323,7 +343,7 @@ _pfz_trylock_and_dequeue:
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
-	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+	CAS_ACQREL w10, w11, x2, w12	 // Atomic CAS with acquire barrier
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
