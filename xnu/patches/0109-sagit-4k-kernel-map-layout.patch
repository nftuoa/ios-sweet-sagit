diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index 00568d3..f267a21 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -2513,14 +2513,20 @@ pmap_virtual_region(
 	vm_map_size_t low_global_vr_size = 0;
 
 	if (region_select == 0) {
-		/* Round to avoid overlapping with the V=P area; round to at least the L2 block size. */
-		if (!TEST_PAGE_SIZE_4K) {
-			*startp = gVirtBase & 0xFFFFFFFFFE000000;
-			*size = ((virtual_space_start - (gVirtBase & 0xFFFFFFFFFE000000)) + ~0xFFFFFFFFFE000000) & 0xFFFFFFFFFE000000;
-		} else {
-			*startp = gVirtBase & 0xFFFFFFFFFF800000;
-			*size = ((virtual_space_start - (gVirtBase & 0xFFFFFFFFFF800000)) + ~0xFFFFFFFFFF800000) & 0xFFFFFFFFFF800000;
-		}
+		/*
+		 * Round to avoid overlapping with the V=P area; round to at least the L2 block size.
+		 *
+		 * These masks describe the kernel address *layout*, not the page size.
+		 * Upstream selects them by TEST_PAGE_SIZE_4K because in Apple's trees
+		 * the 16 KiB page configurations are all ARM_LARGE_MEMORY ones; sagit
+		 * is the opposite combination (4 KiB granule and 16 KiB VM pages on
+		 * the KVA layout 0xfffffff0_xxxx).  The 32 MiB rounding below assumes
+		 * a 0xfffffe00_xxxx layout and underflows into a ~2^63 byte region
+		 * with our base, which corrupts kernel_map; this branch is the
+		 * !ARM_LARGE_MEMORY one, so the 8 MiB variant is the correct one.
+		 */
+		*startp = gVirtBase & 0xFFFFFFFFFF800000;
+		*size = ((virtual_space_start - (gVirtBase & 0xFFFFFFFFFF800000)) + ~0xFFFFFFFFFF800000) & 0xFFFFFFFFFF800000;
 		ret = TRUE;
 	}
 	if (region_select == 1) {
@@ -2529,13 +2535,8 @@ pmap_virtual_region(
 		ret = TRUE;
 	}
 	/* We need to reserve a range that is at least the size of an L2 block mapping for the low globals */
-	if (!TEST_PAGE_SIZE_4K) {
-		low_global_vr_mask = 0xFFFFFFFFFE000000;
-		low_global_vr_size = 0x2000000;
-	} else {
-		low_global_vr_mask = 0xFFFFFFFFFF800000;
-		low_global_vr_size = 0x800000;
-	}
+	low_global_vr_mask = 0xFFFFFFFFFF800000;
+	low_global_vr_size = 0x800000;
 
 	if (((gVirtBase & low_global_vr_mask) != LOW_GLOBAL_BASE_ADDRESS) && (region_select == 2)) {
 		*startp = LOW_GLOBAL_BASE_ADDRESS;
@@ -6881,7 +6882,7 @@ void
 pmap_sync_page_attributes_phys(
 	ppnum_t pp)
 {
-	flush_dcache((vm_offset_t) (pp << PAGE_SHIFT), PAGE_SIZE, TRUE);
+	flush_dcache((vm_offset_t) ((pmap_paddr_t)pp << ARM_PGSHIFT), PAGE_SIZE, TRUE);
 }
 
 #if CONFIG_COREDUMP
