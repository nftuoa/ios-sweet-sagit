diff --git a/osfmk/mach/arm/vm_param.h b/osfmk/mach/arm/vm_param.h
index c013288..d90b86e 100644
--- a/osfmk/mach/arm/vm_param.h
+++ b/osfmk/mach/arm/vm_param.h
@@ -133,9 +133,16 @@ extern int PAGE_SHIFT_CONST;
 
 /* system-wide values */
 #define MACH_VM_MIN_ADDRESS_RAW 0x0ULL
-#if defined(XNU_PLATFORM_MacOSX) || defined(XNU_PLATFORM_DriverKit)
+#if (defined(XNU_PLATFORM_MacOSX) || defined(XNU_PLATFORM_DriverKit)) && !defined(ARM64_BOARD_CONFIG_SAGIT)
 #define MACH_VM_MAX_ADDRESS_RAW 0x00007FFFFE000000ULL
 #else
+/*
+ * sagit is a 4 KiB-granule board built on the MacOSX platform: a 38-bit TTBR0
+ * (T0SZ_BOOT 26) cannot address the macOS 47-bit userspace top, and the
+ * 4 KiB-granule commpage check in pmap.c requires the commpage nesting region
+ * to start above the userspace maximum.  Use the iOS arm64 limits instead -
+ * the same ones the iOS 16 userspace this kernel will host was built with.
+ */
 #define MACH_VM_MAX_ADDRESS_RAW 0x0000000FC0000000ULL
 #endif
 
