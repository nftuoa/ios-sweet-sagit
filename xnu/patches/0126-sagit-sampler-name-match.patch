diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index b40eccd..87862bd 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -26,6 +26,23 @@ extern void sweet_sample_start(void);
 
 static char sweet_sample_names[128];
 
+/* Plain substring search: XNU's libkern has no strstr(). */
+static bool
+sweet_sample_contains(const char *hay, const char *needle)
+{
+	size_t nl = strlen(needle);
+
+	if (nl == 0) {
+		return true;
+	}
+	for (const char *h = hay; *h; h++) {
+		if (strncmp(h, needle, nl) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
 static bool
 sweet_sample_wanted(const char *name)
 {
@@ -36,6 +53,22 @@ sweet_sample_wanted(const char *name)
 		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
 			return true;
 		}
+		/*
+		 * Also accept a substring match in either direction: a launchd
+		 * daemon's comm may be the job label ("com.apple.datamigrator") or
+		 * the executable name ("datamigrator"), and hard-coding both
+		 * spellings in a 128-byte boot-arg does not scale.
+		 */
+		if (tl > 0 && n > 0) {
+			char tok[64];
+			size_t copy = tl < sizeof(tok) - 1 ? tl : sizeof(tok) - 1;
+			memcpy(tok, t, copy);
+			tok[copy] = 0;
+			if (sweet_sample_contains(name, tok) ||
+			    sweet_sample_contains(tok, name)) {
+				return true;
+			}
+		}
 		if (!end) {
 			break;
 		}
