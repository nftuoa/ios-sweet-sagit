+/*
+ * Sleep that actually blocks the calling kernel thread.  IOSleep() is a
+ * delay_for_interval() spin and the synthetic-unlock delays are tens of
+ * seconds, so a wait channel is used instead, as bsd/dev/sweet_keys.c and
+ * bsd/dev/sweet_touch.c do.  Only called from the unlock thread below.
+ */
+static int gSweetHIDSleepChan;
+
+static void
+sweetHIDDelayMS(UInt32 ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&gSweetHIDSleepChan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
