+/*
+ * Lock-screen swipe-up: press at (50%, 85%) of the display, drag straight
+ * up to (50%, 15%) in eight 20 ms steps, then lift.  A slow drag rather
+ * than a fling, so the lock screen tracks the finger and dismisses on lift.
+ * On sagit's 1080x1920 panel that is (540,1632) -> (540,288).
+ */
+void
+SweetHIDTouch::swipeUp(void)
+{
+	const int steps = 8;
+	int x = panelCoord(500, true);
+	int y0 = panelCoord(850, false);
+	int y1 = panelCoord(150, false);
+
+	IOLog("SWEET HID: synthetic swipe %d,%d -> %d,%d (%d moves)\n", x, y0, x, y1, steps);
+	touch(0, true, x, y0);
+	for (int i = 1; i <= steps; i++) {
+		sweetHIDDelayMS(20);
+		touch(0, true, x, y0 + (y1 - y0) * i / steps);
+	}
+	sweetHIDDelayMS(20);
+	touch(0, false, x, y1);
+}
+
+/*
+ * Synthetic unlock: sagit has no working touchscreen driver yet, so the
+ * kernel injects the gesture SpringBoard needs to leave the lock screen.
+ *
+ * On an iPhone X (D22AP) there is no home button and the lock screen is
+ * dismissed by dragging up; a home-button HID event is still accepted
+ * (backboardd turns consumer usage 0x40 into a home-button event) and can
+ * wake the display.  Both go through the services above, which already
+ * publish themselves as built-in Apple HID devices.
+ *
+ * Boot args, in seconds since IOKit matched the HID services (a few seconds
+ * into boot; calibrate against the "SWEET HID: unlock: services at ...
+ * ms" console line):
+ *
+ *   sweethome=N        press+release Home after N s
+ *   sweetswipe=N       swipe up after N s (raised to sweethome+1 if both)
+ *   sweetunlockreps=R  repeat the sequence R times, default 3
+ *   sweetunlockgap=G   seconds between repeats, default 6
+ *
+ * sweethome alone implies sweetswipe=sweethome+1; nothing is injected when
+ * neither sweethome nor sweetswipe is present.
+ *
+ * dispatchEvent() with no client is a silent no-op, and backboardd opens
+ * these services only once userland runs, so every attempt first waits for
+ * a client (15 x 2 s, logging each retry).  The repeats cover the window
+ * where backboardd exists but SpringBoard has not drawn its lock screen
+ * yet: the kernel cannot see SpringBoard itself.
+ */
+#define SWEET_UNLOCK_SERVICE_WAIT_MS	30000
+#define SWEET_UNLOCK_CLIENT_TRIES	15
+#define SWEET_UNLOCK_CLIENT_RETRY_MS	2000
+#define SWEET_UNLOCK_MAX_REPS		10
+#define SWEET_UNLOCK_MAX_SECS		7200
+#define SWEET_UNLOCK_GAP_DEFAULT	6
+
+static bool     gSweetUnlockLaunched;
+static bool     gSweetUnlockHaveHome;
+static bool     gSweetUnlockHaveSwipe;
+static UInt32   gSweetUnlockHomeSecs;
+static UInt32   gSweetUnlockSwipeSecs;
+static UInt32   gSweetUnlockReps;
+static UInt32   gSweetUnlockGapSecs;
+
+static UInt32
+sweetUnlockClientCount(void)
+{
+	UInt32 clients = 0;
+
+	if (gSweetButtons) {
+		clients = gSweetButtons->clientCount();
+	}
+	if (clients == 0 && gSweetTouch) {
+		clients = gSweetTouch->clientCount();
+	}
+	return clients;
+}
+
+static void
+sweetUnlockWaitUntil(UInt64 *elapsedMS, UInt64 targetMS)
+{
+	while (*elapsedMS < targetMS) {
+		sweetHIDDelayMS(100);
+		*elapsedMS += 100;
+	}
+}
+
+/* True once some userland client is reading the events. */
+static bool
+sweetUnlockWaitForClient(UInt64 *elapsedMS)
+{
+	for (UInt32 tries = 0; tries < SWEET_UNLOCK_CLIENT_TRIES; tries++) {
+		if (sweetUnlockClientCount() != 0) {
+			return true;
+		}
+		IOLog("SWEET HID: unlock: no HID client yet (retry %u/%u)\n",
+		    (unsigned)(tries + 1), (unsigned)SWEET_UNLOCK_CLIENT_TRIES);
+		sweetHIDDelayMS(SWEET_UNLOCK_CLIENT_RETRY_MS);
+		*elapsedMS += SWEET_UNLOCK_CLIENT_RETRY_MS;
+	}
+	return sweetUnlockClientCount() != 0;
+}
+
+static void
+sweetUnlockThread(void *arg __unused, wait_result_t result __unused)
+{
+	UInt64 elapsedMS = 0;
+
+	/* start() sets the globals just before registerService(). */
+	for (UInt32 waited = 0; waited < SWEET_UNLOCK_SERVICE_WAIT_MS; waited += 100) {
+		if (gSweetButtons && gSweetTouch) {
+			break;
+		}
+		sweetHIDDelayMS(100);
+		elapsedMS += 100;
+	}
+	IOLog("SWEET HID: unlock: services at %llu ms (buttons=%d touch=%d clients=%u)\n",
+	    (unsigned long long)elapsedMS, gSweetButtons != NULL, gSweetTouch != NULL,
+	    (unsigned)sweetUnlockClientCount());
+
+	if (!gSweetButtons && !gSweetTouch) {
+		IOLog("SWEET HID: unlock: no HID service, nothing to do\n");
+		goto out;
+	}
+	if (gSweetUnlockHaveHome && !gSweetButtons) {
+		IOLog("SWEET HID: unlock: buttons service missing, no home press\n");
+	}
+	if (gSweetUnlockHaveSwipe && !gSweetTouch) {
+		IOLog("SWEET HID: unlock: touch service missing, no swipe\n");
+	}
+
+	for (UInt32 attempt = 0; attempt < gSweetUnlockReps; attempt++) {
+		UInt64 baseMS = (UInt64)attempt * gSweetUnlockGapSecs * 1000;
+
+		if (gSweetUnlockHaveHome && gSweetButtons) {
+			sweetUnlockWaitUntil(&elapsedMS,
+			    baseMS + (UInt64)gSweetUnlockHomeSecs * 1000);
+			if (!sweetUnlockWaitForClient(&elapsedMS)) {
+				IOLog("SWEET HID: unlock: giving up, no HID client\n");
+				break;
+			}
+			IOLog("SWEET HID: unlock %u/%u: home at %llu ms\n",
+			    (unsigned)(attempt + 1), (unsigned)gSweetUnlockReps,
+			    (unsigned long long)elapsedMS);
+			gSweetButtons->pressHome();
+		}
+		if (gSweetUnlockHaveSwipe && gSweetTouch) {
+			sweetUnlockWaitUntil(&elapsedMS,
+			    baseMS + (UInt64)gSweetUnlockSwipeSecs * 1000);
+			if (!sweetUnlockWaitForClient(&elapsedMS)) {
+				IOLog("SWEET HID: unlock: giving up, no HID client\n");
+				break;
+			}
+			IOLog("SWEET HID: unlock %u/%u: swipe at %llu ms\n",
+			    (unsigned)(attempt + 1), (unsigned)gSweetUnlockReps,
+			    (unsigned long long)elapsedMS);
+			gSweetTouch->swipeUp();
+		}
+	}
+	IOLog("SWEET HID: unlock: done after %llu ms\n", (unsigned long long)elapsedMS);
+
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/*
+ * Called from both start() methods; only the first call does anything, so
+ * the thread is created once, after the first service is published (it then
+ * waits for the other service by itself).
+ */
+static void
+sweetUnlockStart(void)
+{
+	int home = 0, swipe = 0, reps = 3, gap = SWEET_UNLOCK_GAP_DEFAULT;
+	bool haveHome, haveSwipe;
+	thread_t thread;
+	kern_return_t kr;
+
+	if (gSweetUnlockLaunched) {
+		return;
+	}
+	gSweetUnlockLaunched = true;
+
+	haveHome = PE_parse_boot_argn("sweethome", &home, sizeof(home)) != 0;
+	haveSwipe = PE_parse_boot_argn("sweetswipe", &swipe, sizeof(swipe)) != 0;
+	if (!haveHome && !haveSwipe) {
+		return;	/* not requested */
+	}
+	if (home < 0) {
+		home = 0;
+	} else if (home > SWEET_UNLOCK_MAX_SECS) {
+		home = SWEET_UNLOCK_MAX_SECS;
+	}
+	if (swipe < 0) {
+		swipe = 0;
+	} else if (swipe > SWEET_UNLOCK_MAX_SECS) {
+		swipe = SWEET_UNLOCK_MAX_SECS;
+	}
+	if (!haveSwipe) {
+		swipe = home + 1;
+		haveSwipe = true;
+	}
+	if (haveHome && swipe < home + 1) {
+		swipe = home + 1;
+	}
+	(void)PE_parse_boot_argn("sweetunlockreps", &reps, sizeof(reps));
+	(void)PE_parse_boot_argn("sweetunlockgap", &gap, sizeof(gap));
+	if (reps < 1) {
+		reps = 1;
+	} else if (reps > SWEET_UNLOCK_MAX_REPS) {
+		reps = SWEET_UNLOCK_MAX_REPS;
+	}
+	if (gap < 1) {
+		gap = 1;
+	}
+
+	gSweetUnlockHaveHome = haveHome;
+	gSweetUnlockHaveSwipe = haveSwipe;
+	gSweetUnlockHomeSecs = (UInt32)home;
+	gSweetUnlockSwipeSecs = (UInt32)swipe;
+	gSweetUnlockReps = (UInt32)reps;
+	gSweetUnlockGapSecs = (UInt32)gap;
+
+	if (haveHome) {
+		IOLog("SWEET HID: unlock plan: home at %u s, swipe at %u s, %u attempt(s) every %u s\n",
+		    (unsigned)home, (unsigned)swipe, (unsigned)reps, (unsigned)gap);
+	} else {
+		IOLog("SWEET HID: unlock plan: swipe only at %u s, %u attempt(s) every %u s\n",
+		    (unsigned)swipe, (unsigned)reps, (unsigned)gap);
+	}
+
+	kr = kernel_thread_start(&sweetUnlockThread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		IOLog("SWEET HID: unlock: kernel_thread_start failed %d\n", kr);
+	}
+}
