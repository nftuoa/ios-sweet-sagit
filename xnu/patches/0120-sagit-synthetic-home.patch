+/* 1/1000 of the presented display -> panel pixel (inverse of touch()). */
+int
+SweetHIDTouch::panelCoord(int permille, bool horizontal) const
+{
+	int logical = horizontal ? fLogicalW : fLogicalH;
+	int off = horizontal ? fOffX : fOffY;
+
+	return (int)(((int64_t)permille * (int64_t)logical) / 1000) - off;
+}
