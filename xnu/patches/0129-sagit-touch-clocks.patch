+/* One decoded line per touch pin so the log can be compared with
+ * pinctrl-msm8998.c and the stock DTB without a calculator: mux is
+ * bits[4:2], pull bits[1:0], drive bits[8:6] (2 mA * (n + 1)), output
+ * enable bit 9, and the IO register's bit 0 is the pin level. */
+static void
+touch_pins_log(const char *when)
+{
+	static const struct {
+		const char *name;
+		bool north;
+		unsigned pin;
+	} pin[] = {
+		{ "sda", false, GPIO_TS_SDA },
+		{ "scl", false, GPIO_TS_SCL },
+		{ "rst", false, GPIO_TS_RESET },
+		{ "irq", false, GPIO_TS_IRQ },
+		{ "avdd", true, GPIO_TS_AVDD_EN },
+	};
+	static const char * const pull[] = { "none", "down", "keep", "up" };
+	static const char * const drv[] = { "2", "4", "6", "8", "10", "12",
+	    "14", "16" };
+
+	for (unsigned i = 0; i < sizeof(pin) / sizeof(pin[0]); ++i) {
+		vm_offset_t base = pin[i].north ? st.tlmm_n : st.tlmm_e;
+		uint32_t cfg = touch_rd(base, TLMM_CFG(pin[i].pin));
+		uint32_t io = touch_rd(base, TLMM_IO(pin[i].pin));
+
+		printf("SAGIT TOUCH: pin %s %s(gpio%u) mux=%u pull=%s "
+		    "drive=%smA %s level=%u cfg=%#x\n", when, pin[i].name,
+		    pin[i].pin, (cfg >> 2) & 7u, pull[cfg & 3u],
+		    drv[(cfg >> 6) & 7u], (cfg & TLMM_OE) ? "out" : "in",
+		    io & 1u, cfg);
+	}
