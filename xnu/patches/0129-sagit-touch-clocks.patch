 /* GCC clocks                                                          */
 /* ------------------------------------------------------------------ */
+/* CBCR halt status is bits[31:28]: 0x0 = on, 0x2 = on (NOC FSM), 0x8 =
+ * halted (clock-local2.c BRANCH_ON_VAL / BRANCH_NOC_FSM_ON_VAL /
+ * BRANCH_OFF_VAL). Only the top nibble is looked at, so a write that
+ * clears other status bits (the old CBCR write did) is not mistaken for
+ * progress. */
+static bool
+gcc_branch_running(uint32_t cbcr)
+{
+	uint32_t halt = cbcr & GCC_CBCR_HALT_MASK;
+
+	return halt == GCC_CBCR_HALT_ON || halt == GCC_CBCR_HALT_ON_NOC;
+}
+
+/* Poll a CBCR until the branch reports running; return the last read. */
+static uint32_t
+gcc_wait_branch(uint32_t off, unsigned ms)
+{
+	uint32_t v = touch_rd(st.gcc, off);
+
+	for (unsigned i = 0; i < ms * 1000u; ++i) {
+		if (gcc_branch_running(v)) {
+			break;
+		}
+		delay(1);
+		v = touch_rd(st.gcc, off);
+	}
+	return v;
+}
+
+/* CMD_RCGR.UPDATE self-clears once the RCG has taken the new config. */
+static uint32_t
+gcc_rcg_update(uint32_t cmd_off)
+{
+	touch_wr(st.gcc, cmd_off, touch_rd(st.gcc, cmd_off) | GCC_CMD_UPDATE);
+	(void)touch_poll_clear(st.gcc, cmd_off, GCC_CMD_UPDATE, 5);
+	return touch_rd(st.gcc, cmd_off);
+}
+
+/* CMD_RCGR.ROOT_OFF (bit 31) clears once the root generates a clock. */
+static uint32_t
+gcc_wait_root(uint32_t cmd_off, unsigned ms)
+{
+	uint32_t v = touch_rd(st.gcc, cmd_off);
+
+	for (unsigned i = 0; i < ms * 1000u; ++i) {
+		if (!(v & GCC_CMD_ROOT_OFF)) {
+			break;
+		}
+		delay(1);
+		v = touch_rd(st.gcc, cmd_off);
+	}
+	return v;
+}
