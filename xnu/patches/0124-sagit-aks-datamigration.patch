diff --git a/iokit/Kernel/arm/SweetKeyStore.cpp b/iokit/Kernel/arm/SweetKeyStore.cpp
index d11fe26..3bf2d1f 100644
--- a/iokit/Kernel/arm/SweetKeyStore.cpp
+++ b/iokit/Kernel/arm/SweetKeyStore.cpp
@@ -42,6 +42,16 @@ enum {
 	kAKSGetSystem        = 14,
 	kAKSGetDeviceState   = 17,
 	kAKSGetExtDeviceState = 35,     /* aks_get_extended_device_state */
+	/*
+	 * DataMigration (com.apple.datamigrator) probes these two before it
+	 * decides whether there is anything to migrate.  Returning
+	 * kIOReturnUnsupported made the migration XPC never return, which in
+	 * turn blocks backboardd's BKMigrator, and SpringBoard's
+	 * FBSystemShellInitialize check-in waits for that reply forever (its
+	 * main thread sits in xpc_connection_send_message_with_reply_sync).
+	 */
+	kAKSGetInternalInfo  = 93,      /* aks_get_internal_info: blob out */
+	kAKSStashLoad        = 34,      /* aks_stash_load: bool out */
 	kAKSAssertHold       = 26,
 	kAKSAssertDrop       = 27,
 	kAKSUnloadSessionBags = 55,
@@ -227,6 +237,28 @@ AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArgum
 		args->scalarOutputCount = 0;
 		ret = sweet_aks_device_state(args);
 		break;
+	case kAKSGetInternalInfo:
+		/*
+		 * aks_get_internal_info: one scalar in, a caller-sized info blob
+		 * out.  There is no SEP and no internal keybag here, so an
+		 * all-zero blob (the caller's buffer is already zeroed) with a
+		 * successful return is the honest answer: "no internal info".
+		 * The buffer is copied out to the caller as-is, so zero it here.
+		 */
+		if (args->structureOutput != NULL && args->structureOutputSize > 0) {
+			bzero(args->structureOutput, args->structureOutputSize);
+		}
+		args->scalarOutputCount = 0;
+		break;
+	case kAKSStashLoad:
+		/* aks_stash_load: two scalars in, one bool out; 0 = no stash. */
+		if (out_scalars < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		args->scalarOutput[0] = 0;
+		args->scalarOutputCount = 1;
+		break;
 	default:
 		ret = kIOReturnUnsupported;
 		break;
