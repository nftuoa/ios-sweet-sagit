diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 6b926fe..93d1aaf 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -786,6 +786,53 @@ sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 	}
 }
 
+/*
+ * Panic path: write the console ring out synchronously.  Called from
+ * panic_trap_to_debugger() after the panic text has gone to the console, with
+ * interrupts off and the other CPUs stopped, so this must not sleep or take
+ * the UFS mutex - only the polled command path is used.
+ */
+void
+sweet_log_panic_flush(void);
+
+void
+sweet_log_panic_flush(void)
+{
+	uint64_t base, total, pos;
+	void *bounce;
+
+	if (!su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
+		return;
+	}
+	base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	total = os_atomic_load(&sweet_log_total, relaxed);
+	if (total == 0) {
+		return;
+	}
+	pos = total >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : 0;
+	bounce = (void *)(su.dma + DMA_BOUNCE);
+	while (pos < total) {
+		uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		uint64_t need = ((uint64_t)(off % UFS_BLOCK) + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+		    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+		memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		if (ufs_write_blocks(base + 1 + blk, n) != 0) {
+			return;
+		}
+		pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+	}
+	struct sweet_log_header h = {
+		.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+		.version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = 0xffffffffu,
+	};
+	bzero(bounce, UFS_BLOCK);
+	memcpy(bounce, &h, sizeof(h));
+	(void)ufs_write_blocks(base, 1);
+	(void)ufs_sync_cache();
+}
+
 static void
 sweet_log_start(void)
 {
diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
index 437adb1..cbc53d7 100644
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -1087,6 +1087,18 @@ panic_trap_to_debugger(const char *panic_format_str, va_list *panic_args, unsign
 	/* call machine-layer panic handler */
 	ml_panic_trap_to_debugger(panic_format_str, panic_args, reason, ctx, panic_options_mask, panic_caller);
 
+#if defined(SWEET)
+	/*
+	 * The panic text has just gone through the console, i.e. into the
+	 * persistent log ring; write that ring out now so the panic survives
+	 * the reboot (the periodic flusher never runs again).
+	 */
+	{
+		extern void sweet_log_panic_flush(void);
+		sweet_log_panic_flush();
+	}
+#endif
+
 	/* track depth of debugger/panic entry */
 	CPUDEBUGGERCOUNT++;
 
