diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index 42362c5..c3e3046 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -396,6 +396,18 @@ arm_init(
 
 
 	{
+#if defined(ARM64_BOARD_CONFIG_SAGIT) && !__ARM_16K_PG__
+		/*
+		 * Mi 6: the hardware only implements the 4 KiB granule, but the
+		 * iPhone X iOS 16 userspace this kernel hosts is built for 16 KiB
+		 * pages (its CodeDirectory.pageSize is 14).  Keep Apple's 4K-profile
+		 * page size - 16 KiB VM pages over four 4 KiB PTEs per page
+		 * (PAGE_RATIO == 4) - instead of deriving it from RAM size, so a
+		 * memory-map change can never silently downgrade the user ABI to 4 KiB.
+		 */
+		PAGE_SHIFT_CONST = PAGE_MAX_SHIFT;
+		page_shift_user32 = PAGE_MAX_SHIFT;
+#else
 		/*
 		 * Select the advertised kernel page size.
 		 */
@@ -416,6 +428,7 @@ arm_init(
 
 		/* 32-bit apps always see 16KB page size */
 		page_shift_user32 = PAGE_MAX_SHIFT;
+#endif
 #ifdef  APPLETYPHOON
 		if (PE_parse_boot_argn("cpus_defeatures", &cpus_defeatures, sizeof(cpus_defeatures))) {
 			if ((cpus_defeatures & 0xF) != 0) {
diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index 00568d3..c1069e7 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -6881,7 +6881,7 @@ void
 pmap_sync_page_attributes_phys(
 	ppnum_t pp)
 {
-	flush_dcache((vm_offset_t) (pp << PAGE_SHIFT), PAGE_SIZE, TRUE);
+	flush_dcache((vm_offset_t) ((pmap_paddr_t)pp << ARM_PGSHIFT), PAGE_SIZE, TRUE);
 }
 
 #if CONFIG_COREDUMP
